#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
#
# hid-multitouch 能力自证：在没有物理触控板的情况下，证明
# 「驱动能真正绑定一个 MT 设备，并产出 ABS_MT_SLOT / ABS_MT_TRACKING_ID」。
#
# 为什么需要这个脚本：
#   insmod 成功 + /sys/bus/hid/drivers 下出现驱动目录，只证明**驱动注册**成功。
#   它不证明驱动能绑定设备，更不证明绑定后产出的是多点触控语义而不是单点鼠标。
#   没有物理触控板时，这两步通常被跳过，于是「能力已具备」是个未验证的断言。
#
# 做法：
#   用 /dev/uhid 从用户态造一个 HID 数字转换器（Digitizer/Touch Screen）设备，
#   内核 HID 核心会把它判为 HID_GROUP_MULTITOUCH，hid-multitouch 的通用
#   id_table 条目（HID_BUS_ANY / HID_GROUP_MULTITOUCH / HID_ANY_ID / HID_ANY_ID）
#   会自动绑定。随后检查产出的 input 节点是否带 MT 能力位，并真的写一帧触摸
#   报告，确认事件从 HID 层一路走到 input 层。
#
# 为什么这算证据而不算模拟真机：
#   它验证的是「驱动与内核 HID 栈对接正确」——HID 报告描述符解析、MT 字段映射、
#   input 槽位分配。这三件事与设备是 USB 还是 uhid 无关。
#   它不验证的：具体触控板的固件行为、VID/PID 是否需要 new_id、以及贴合精度。
#   那些只能靠实物。本脚本不因此宣称「触控板已验证可用」。
#
# 用法（板端，需 root）：
#   sudo python3 probe_virtual_mt.py
#
# 退出码：
#   0 驱动绑定 + MT 能力位齐全 + 收到 MT 事件（能力闭环）
#   2 设备已创建但未被 hid-multitouch 绑定（驱动匹配面有问题）
#   3 已绑定但 input 节点缺 MT 能力位（字段映射有问题）
#   4 能力位齐全但未收到 MT 事件（事件通路有问题）
#   5 环境不满足（/dev/uhid 不可用 / 无权限）

import os
import select
import struct
import sys
import time

UHID_DEV = "/dev/uhid"

# ---- uhid 协议常量（include/uapi/linux/uhid.h）---------------------------
UHID_DESTROY = 1
UHID_CREATE2 = 11
UHID_INPUT2 = 13

HID_MAX_DESCRIPTOR_SIZE = 4096
UHID_EVENT_SIZE = 4 + (128 + 64 + 64 + 2 + 2 + 4 + 4 + 4 + 4 + HID_MAX_DESCRIPTOR_SIZE)

BUS_USB = 0x03

# ---- 报告描述符 ---------------------------------------------------------
# 一个最小可用的多点触控触摸屏描述符：
#   Digitizer / Touch Screen / Application
#     Finger / Logical
#       Tip Switch (1 bit) + 7 bit padding
#       Contact Identifier (8 bit)
#       X, Y (16 bit, 0..32767)
#
# 关键点是有 Contact Identifier（HID_DG_CONTACTID）：hid-multitouch 见到它才会
# 分配 maxcontacts 并调用 input_mt_init_slots()，也才会有 ABS_MT_SLOT 与
# ABS_MT_TRACKING_ID。只有 X/Y 而无 ContactID 的设备会被当成单点设备——
# 这正是「evtest 能打印坐标但实际不是多点触控」的那种情况。
REPORT_DESCRIPTOR = bytes([
    0x05, 0x0d,        # Usage Page (Digitizer)
    0x09, 0x04,        # Usage (Touch Screen)
    0xa1, 0x01,        # Collection (Application)
    0x85, 0x01,        #   Report ID (1)
    0x09, 0x22,        #   Usage (Finger)
    0xa1, 0x02,        #   Collection (Logical)
    0x09, 0x42,        #     Usage (Tip Switch)
    0x15, 0x00,        #     Logical Minimum (0)
    0x25, 0x01,        #     Logical Maximum (1)
    0x75, 0x01,        #     Report Size (1)
    0x95, 0x01,        #     Report Count (1)
    0x81, 0x02,        #     Input (Data,Var,Abs)
    0x95, 0x07,        #     Report Count (7)
    0x81, 0x03,        #     Input (Const,Var,Abs)
    0x09, 0x51,        #     Usage (Contact Identifier)
    0x75, 0x08,        #     Report Size (8)
    0x95, 0x01,        #     Report Count (1)
    0x81, 0x02,        #     Input (Data,Var,Abs)
    0x05, 0x01,        #     Usage Page (Generic Desktop)
    0x09, 0x30,        #     Usage (X)
    0x09, 0x31,        #     Usage (Y)
    0x16, 0x00, 0x00,  #     Logical Minimum (0)
    0x26, 0xff, 0x7f,  #     Logical Maximum (32767)
    0x75, 0x10,        #     Report Size (16)
    0x95, 0x02,        #     Report Count (2)
    0x81, 0x02,        #     Input (Data,Var,Abs)
    0xc0,              #   End Collection
    0xc0,              # End Collection
])

# ---- input 事件常量（include/uapi/linux/input-event-codes.h）-------------
EV_SYN = 0x00
EV_KEY = 0x01
EV_ABS = 0x03

ABS_MT_SLOT = 0x2f
ABS_MT_TOUCH_MAJOR = 0x30
ABS_MT_POSITION_X = 0x35
ABS_MT_POSITION_Y = 0x36
ABS_MT_TRACKING_ID = 0x39

ABS_NAMES = {
    ABS_MT_SLOT: "ABS_MT_SLOT",
    ABS_MT_TOUCH_MAJOR: "ABS_MT_TOUCH_MAJOR",
    ABS_MT_POSITION_X: "ABS_MT_POSITION_X",
    ABS_MT_POSITION_Y: "ABS_MT_POSITION_Y",
    ABS_MT_TRACKING_ID: "ABS_MT_TRACKING_ID",
}

# struct input_event on aarch64: timeval(16) + type(2) + code(2) + value(4)
INPUT_EVENT = struct.Struct("qqHHi")


def log(msg=""):
    print(msg, flush=True)


def die_env(msg):
    log("环境不满足: " + msg)
    sys.exit(5)


def build_create2(name, phys, uniq, rd, bus, vendor, product, version):
    ev = bytearray(UHID_EVENT_SIZE)
    struct.pack_into("<I", ev, 0, UHID_CREATE2)
    for off, val, size in ((4, name, 128), (132, phys, 64), (196, uniq, 64)):
        raw = val.encode()
        if len(raw) > size - 1:  # 必须留结尾 NUL
            raise ValueError("uhid 字段过长: %r" % val)
        ev[off:off + len(raw)] = raw
    struct.pack_into("<H", ev, 260, len(rd))
    struct.pack_into("<H", ev, 262, bus)
    struct.pack_into("<I", ev, 264, vendor)
    struct.pack_into("<I", ev, 268, product)
    struct.pack_into("<I", ev, 272, version)
    struct.pack_into("<I", ev, 276, 0)  # country
    ev[280:280 + len(rd)] = rd
    return bytes(ev)


def build_input2(data):
    ev = bytearray(UHID_EVENT_SIZE)
    struct.pack_into("<I", ev, 0, UHID_INPUT2)
    struct.pack_into("<H", ev, 4, len(data))
    ev[6:6 + len(data)] = data
    return bytes(ev)


def build_destroy():
    ev = bytearray(UHID_EVENT_SIZE)
    struct.pack_into("<I", ev, 0, UHID_DESTROY)
    return bytes(ev)


def snapshot_event_nodes():
    """返回 {eventN: device_name}，来自 /proc/bus/input/devices。"""
    nodes = {}
    cur_name = None
    try:
        with open("/proc/bus/input/devices") as f:
            for line in f:
                line = line.rstrip("\n")
                if line.startswith("N: Name="):
                    cur_name = line[len("N: Name="):].strip('"')
                elif line.startswith("H: Handlers=") and "event" in line:
                    for tok in line.split():
                        if tok.startswith("event"):
                            nodes[tok] = cur_name
    except OSError:
        pass
    return nodes


def find_hid_device_by_name(name):
    """在 /sys/bus/hid/devices 下按 HID 设备名找目录名（形如 0003:222A:0001.0001）。"""
    base = "/sys/bus/hid/devices"
    try:
        entries = os.listdir(base)
    except OSError:
        return None
    for e in entries:
        p = os.path.join(base, e, "name")
        try:
            with open(p) as f:
                if f.read().strip() == name:
                    return e
        except OSError:
            continue
    return None


def driver_of(hiddev):
    link = "/sys/bus/hid/devices/%s/driver" % hiddev
    try:
        return os.path.basename(os.readlink(link))
    except OSError:
        return None


def abs_capabilities(event_node):
    """读 /sys/class/input/eventN/device/capabilities/abs 的十六进制位图。"""
    path = "/sys/class/input/%s/device/capabilities/abs" % event_node
    try:
        with open(path) as f:
            text = f.read().strip()
    except OSError:
        return set()
    if not text:
        return set()
    mask = int(text, 16)
    return {code for code in range(0, 64) if mask & (1 << code)}


def try_bind_via_new_id(hiddev, bus, vendor, product):
    """驱动没自动绑定时，用 sysfs new_id 强制匹配一次。"""
    path = "/sys/bus/hid/drivers/hid-multitouch/new_id"
    if not os.path.exists(path):
        return False
    line = "%04x %04x %04x" % (bus, vendor, product)
    try:
        with open(path, "w") as f:
            f.write(line)
        return True
    except OSError as exc:
        log("  new_id 写入失败: %s" % exc)
        return False


def read_mt_events(fd, timeout=1.0):
    """从 input 节点读事件，返回 [(type, code, value)]。"""
    got = []
    deadline = time.time() + timeout
    while time.time() < deadline:
        remain = deadline - time.time()
        if remain <= 0:
            break
        r, _, _ = select.select([fd], [], [], remain)
        if not r:
            continue
        try:
            buf = os.read(fd, INPUT_EVENT.size * 64)
        except OSError:
            break
        if not buf:
            break
        for off in range(0, len(buf) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            _, _, etype, code, value = INPUT_EVENT.unpack_from(buf, off)
            got.append((etype, code, value))
    return got


def main():
    if os.geteuid() != 0:
        die_env("需要 root 才能写 /dev/uhid")
    if not os.path.exists(UHID_DEV):
        die_env("%s 不存在（CONFIG_UHID 未加载？）" % UHID_DEV)

    name = "weaknet-virtual-touchscreen"
    vendor, product, version = 0x222A, 0x0001, 0x0100

    log("=== 前置检查 ===")
    log("  %s 可写: %s" % (UHID_DEV, os.access(UHID_DEV, os.W_OK)))
    before_nodes = snapshot_event_nodes()
    log("  现有 input event 节点数: %d" % len(before_nodes))
    log()

    uhid = os.open(UHID_DEV, os.O_RDWR)
    rc = 0
    try:
        log("=== 创建虚拟 HID 设备 ===")
        log("  name=%s  bus=0x%02x  vid:pid=%04X:%04X  rd_size=%d"
            % (name, BUS_USB, vendor, product, len(REPORT_DESCRIPTOR)))
        os.write(uhid, build_create2(name, "uhid/probe", "weaknet", REPORT_DESCRIPTOR,
                                     BUS_USB, vendor, product, version))
        time.sleep(0.4)  # 给内核 HID 核心解析描述符 + 驱动 probe 的时间

        hiddev = find_hid_device_by_name(name)
        if not hiddev:
            log("  失败: /sys/bus/hid/devices 下没有出现该设备")
            return 5
        log("  HID 设备目录: %s" % hiddev)

        try:
            with open("/sys/bus/hid/devices/%s/modalias" % hiddev) as f:
                log("  modalias: %s" % f.read().strip())
        except OSError:
            pass

        drv = driver_of(hiddev)
        log("  绑定驱动: %s" % (drv or "(未绑定)"))
        if drv != "hid-multitouch":
            log("  尝试 new_id 强制匹配 …")
            if try_bind_via_new_id(hiddev, BUS_USB, vendor, product):
                time.sleep(0.3)
                drv = driver_of(hiddev)
                log("  重试后绑定驱动: %s" % (drv or "(仍未绑定)"))

        if drv != "hid-multitouch":
            log()
            log("结论: 设备已创建但未被 hid-multitouch 绑定")
            log("      → 驱动匹配面有问题，需要检查 group 判定或 id_table")
            return 2
        log()

        # ---- 找新出现的 input event 节点 ----
        after_nodes = snapshot_event_nodes()
        new_nodes = [n for n in after_nodes if n not in before_nodes]
        log("=== input 节点 ===")
        log("  新增 event 节点: %s" % (", ".join(new_nodes) if new_nodes else "(无)"))
        if not new_nodes:
            log()
            log("结论: 已绑定但未产出 input 节点")
            return 3
        event_node = new_nodes[0]
        log("  设备名: %s" % after_nodes.get(event_node))
        log()

        # ---- 能力位检查 ----
        caps = abs_capabilities(event_node)
        log("=== ABS 能力位 ===")
        mt_caps = sorted(c for c in caps if c in ABS_NAMES)
        for c in mt_caps:
            log("  %s (0x%02x)" % (ABS_NAMES[c], c))
        other = sorted(c for c in caps if c not in ABS_NAMES)
        if other:
            log("  其他 ABS 位: %s" % ", ".join("0x%02x" % c for c in other))

        # 判定「是不是真的多点触控」的判据。这正是方案文档反复强调的
        # evtest 陷阱：ABS_X/ABS_Y 存在只说明能报坐标，不代表支持多点。
        required = [ABS_MT_SLOT, ABS_MT_TRACKING_ID, ABS_MT_POSITION_X, ABS_MT_POSITION_Y]
        missing = [ABS_NAMES[c] for c in required if c not in caps]
        if missing:
            log()
            log("结论: 缺关键 MT 能力位 %s" % ", ".join(missing))
            log("      → 该设备会被当成单点/鼠标设备，不是真正多点触控")
            return 3
        log("  关键 MT 能力位齐全: ABS_MT_SLOT / ABS_MT_TRACKING_ID / POSITION_X / POSITION_Y")
        log()

        # ---- 真的写一帧触摸，看事件是否流出 ----
        log("=== 写入一帧触摸报告 ===")
        # report id 1 | tip switch=1 | contact id=5 | X=2048 | Y=2048
        report = bytes([0x01, 0x01, 0x05, 0x00, 0x08, 0x00, 0x08])
        log("  UHID_INPUT2 data = %s" % report.hex(" "))
        fd = os.open("/dev/input/%s" % event_node, os.O_RDONLY | os.O_NONBLOCK)
        try:
            os.write(uhid, build_input2(report))
            events = read_mt_events(fd, timeout=1.0)
        finally:
            os.close(fd)

        log("  收到 %d 个 input 事件" % len(events))
        mt_events = [(t, c, v) for (t, c, v) in events if t == EV_ABS and c in ABS_NAMES]
        for (_, c, v) in mt_events:
            log("    EV_ABS %-20s = %d" % (ABS_NAMES[c], v))

        if not mt_events:
            log()
            log("结论: 能力位齐全但未收到 MT 事件")
            log("      → 事件通路有问题（映射/同步/report 格式）")
            return 4

        log()
        log("结论: 能力闭环成立")
        log("      hid-multitouch 已绑定 MT 设备，input 节点带完整 MT 能力位，")
        log("      且 HID 报告经内核栈正确转换为 ABS_MT_* 事件。")
        rc = 0
    finally:
        try:
            os.write(uhid, build_destroy())
            time.sleep(0.2)
        except OSError:
            pass
        os.close(uhid)
        log()
        log("=== 清理 ===")
        left = find_hid_device_by_name(name)
        log("  HID 设备目录残留: %s" % (left or "无（已销毁）"))
    return rc


if __name__ == "__main__":
    sys.exit(main())
