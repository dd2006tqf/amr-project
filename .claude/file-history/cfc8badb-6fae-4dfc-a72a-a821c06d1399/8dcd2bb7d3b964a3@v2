import json
import sys
import urllib.request

BASE_MCU = "https://raw.githubusercontent.com/czu963889306-dev/leap_ros_mcu_driver/main/"
BASE_WS = "https://raw.githubusercontent.com/czu963889306-dev/leap_ros_ws/master/"


def get(url, timeout=60):
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "ignore")


def show(title, url, limit=None):
    print("=" * 25, title)
    try:
        txt = get(url)
    except Exception as e:
        print("FETCH FAIL:", e)
        return
    lines = txt.splitlines()
    if limit:
        lines = lines[:limit]
    print("\n".join(lines))
    print()


which = sys.argv[1]

if which == "mcu":
    show("board_config.h", BASE_MCU + "main/config/board_config.h")
    show("motion_config.h", BASE_MCU + "main/config/motion_config.h")
elif which == "proto":
    show("doc/protocols.md", BASE_MCU + "doc/protocols.md", 260)
elif which == "tree":
    url = "https://api.github.com/repos/czu963889306-dev/leap_ros_ws/git/trees/master?recursive=1"
    d = json.loads(get(url, 120))
    for t in d.get("tree", []):
        if t["type"] != "blob":
            continue
        p = t["path"]
        if "bringup" in p or "leap_interfaces" in p:
            print("%8d %s" % (t.get("size", 0), p))
elif which == "file":
    show(sys.argv[2], BASE_WS + sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else None)
