```cpp
struct { nlmsghdr nlh; inet_diag_req_v2 req; } msg{};
msg.nlh.nlmsg_type  = SOCK_DIAG_BY_FAMILY;
msg.nlh.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
msg.req.sdiag_protocol = IPPROTO_TCP;
msg.req.idiag_states   = 0xFFFFFFFFu;
msg.req.idiag_ext      = (1 << (INET_DIAG_INFO - 1));
sendmsg(nlSock, &msgh, 0);

// 循环 recvmsg → NLMSG_DONE 结束、NLMSG_ERROR 报错
// TLV 遍历找 INET_DIAG_INFO → reinterpret_cast 成 tcp_info
totalRetrans += ti->tcpi_total_retrans;                          // 分子
segsOutApprox += ti->tcpi_unacked + ti->tcpi_retrans + ti->tcpi_sacked; // 近似分母
```

