void NetworkEventManager::emitEvent(const NetworkEvent& event) {
    invokeCallbacks(event.type, event);                    // 通道一：进程内回调

    if (server_ctx_ && server_ctx_->service) {             // 通道二：D-Bus 信号
        std::string signalName = getSignalName(event.type);
        std::string fullMessage = event.source.empty() ? event.message : "[" + event.source + "] " + event.message;
        static std::atomic<int32_t> eventCounter{0};       // 跨类型递增，供接收方排序去重
