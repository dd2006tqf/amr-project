// ---------------------------------------------------------------- 序列化

TEST(TopologyOverlaySerializeTest, RoundTripsAllFields) {
  auto overlay = MakeOverlay("fnv1a64_cafe");
  overlay.revision = 7;
  overlay.updated_at = "2026-10-28T12:00:00Z";
  overlay.blocked_edges.push_back(MakeEdge("a", "b", "水管施工"));
  overlay.one_way_edges.push_back(MakeEdge("b", "c", "单向走廊"));
  OverlayMarker marker;
  marker.id = "temp_1";
  marker.type = "dropoff";
  marker.x = 3.25;
  marker.y = -1.5;
  marker.yaw = 0.75;
  marker.reason = "临时卸货点";
  marker.operator_id = "op_2";
  marker.created_at = "2026-10-28T12:00:00Z";
  overlay.added_markers.push_back(marker);

  const std::string text = SerializeTopologyOverlay(overlay);
  std::string message;
  const auto parsed = DeserializeTopologyOverlay(text, &message);
  ASSERT_TRUE(parsed.has_value()) << message;

  EXPECT_EQ(parsed->base_map_hash, overlay.base_map_hash);
  EXPECT_EQ(parsed->revision, overlay.revision);
  EXPECT_EQ(parsed->updated_at, overlay.updated_at);
  ASSERT_EQ(parsed->blocked_edges.size(), 1u);
  EXPECT_EQ(parsed->blocked_edges.front().reason, "水管施工");
  ASSERT_EQ(parsed->one_way_edges.size(), 1u);
  EXPECT_EQ(parsed->one_way_edges.front().from, "b");
  ASSERT_EQ(parsed->added_markers.size(), 1u);
  EXPECT_DOUBLE_EQ(parsed->added_markers.front().x, 3.25);
  EXPECT_DOUBLE_EQ(parsed->added_markers.front().yaw, 0.75);
  EXPECT_EQ(parsed->added_markers.front().type, "dropoff");
}

TEST(TopologyOverlaySerializeTest, IsDeterministic) {
  auto overlay = MakeOverlay("h");
  overlay.blocked_edges.push_back(MakeEdge("a", "b"));
  OverlayMarker marker;
  marker.id = "m";
  marker.x = 1.0 / 3.0;
  marker.operator_id = "op";
  overlay.added_markers.push_back(marker);

  // 同一份数据序列化两次必须字节相同（否则 e2e 的"拒绝时文件未改写"断言无法成立）
  EXPECT_EQ(SerializeTopologyOverlay(overlay), SerializeTopologyOverlay(overlay));
}

TEST(TopologyOverlaySerializeTest, RejectsCorruptText) {
  std::string message;
  EXPECT_FALSE(DeserializeTopologyOverlay("this is not an overlay\n", &message).has_value());
  EXPECT_FALSE(message.empty());
}

TEST(TopologyOverlaySerializeTest, RejectsUnknownTopLevelKey) {
  std::string message;
  const std::string text =
      "base_map_hash: \"h\"\n"
      "blocked_edges:\n"
      "bogus_key: 1\n";
  EXPECT_FALSE(DeserializeTopologyOverlay(text, &message).has_value());
  EXPECT_TRUE(message.find("unknown top-level key") != std::string::npos) << message;
}

TEST(TopologyOverlaySerializeTest, RejectsMissingBaseHash) {
  std::string message;
  const std::string text = "blocked_edges:\n  - from: \"a\"\n    to: \"b\"\n";
  EXPECT_FALSE(DeserializeTopologyOverlay(text, &message).has_value());
  EXPECT_TRUE(message.find("base_map_hash") != std::string::npos) << message;
}

TEST(TopologyOverlaySerializeTest, AcceptsCommentsAndBlankLines) {
  std::string message;
  const std::string text =
      "# 现场施工区\n"
      "\n"
      "base_map_hash: \"h\"\n"
      "blocked_edges:\n"
      "  # A 段水管爆裂\n"
      "  - from: \"a\"\n"
      "    to: \"b\"\n"
      "    reason: \"water main\"\n"
      "    operator_id: \"op\"\n";
  const auto parsed = DeserializeTopologyOverlay(text, &message);
  ASSERT_TRUE(parsed.has_value()) << message;
  ASSERT_EQ(parsed->blocked_edges.size(), 1u);
  EXPECT_EQ(parsed->blocked_edges.front().reason, "water main");
}

// ---------------------------------------------------------------- 语义签名

TEST(TopologyOverlaySignatureTest, IgnoresRevisionAndAuditFields) {
  auto first = MakeOverlay("h");
  first.revision = 1;
  first.updated_at = "2026-10-28T10:00:00Z";
  first.blocked_edges.push_back(MakeEdge("a", "b", "reason A"));

  auto second = MakeOverlay("h");
  second.revision = 9;
  second.updated_at = "2026-10-29T10:00:00Z";
  second.blocked_edges.push_back(MakeEdge("a", "b", "reason B"));

  // 幂等判定的依据：语义相同 -> 提交返回 no_change、不写盘
  EXPECT_EQ(TopologyOverlaySignature(first), TopologyOverlaySignature(second));
}

TEST(TopologyOverlaySignatureTest, IgnoresEntryOrderButNotDirection) {
  auto first = MakeOverlay("h");
  first.blocked_edges.push_back(MakeEdge("a", "b"));
  first.blocked_edges.push_back(MakeEdge("b", "c"));

  auto reordered = MakeOverlay("h");
  reordered.blocked_edges.push_back(MakeEdge("b", "c"));
  reordered.blocked_edges.push_back(MakeEdge("a", "b"));
  EXPECT_EQ(TopologyOverlaySignature(first), TopologyOverlaySignature(reordered));

  // 单向是**有方向**的：a->b 与 b->a 不是同一个变更
  auto one_way_ab = MakeOverlay("h");
  one_way_ab.one_way_edges.push_back(MakeEdge("a", "b"));
  auto one_way_ba = MakeOverlay("h");
  one_way_ba.one_way_edges.push_back(MakeEdge("b", "a"));
  EXPECT_NE(TopologyOverlaySignature(one_way_ab), TopologyOverlaySignature(one_way_ba));
}

TEST(TopologyOverlaySignatureTest, DistinguishesBlockFromOneWay) {
  auto blocked = MakeOverlay("h");
  blocked.blocked_edges.push_back(MakeEdge("a", "b"));
  auto one_way = MakeOverlay("h");
  one_way.one_way_edges.push_back(MakeEdge("a", "b"));
  EXPECT_NE(TopologyOverlaySignature(blocked), TopologyOverlaySignature(one_way));
}

