#!/usr/bin/env bash
# 验证修复后的 entrypoint 两阶段列表能在干净工作区完成构建。
# 复用 /tmp/cleanws2 的 phase1 产物（只用增量，不再重编 core/interfaces）。
set -o pipefail

WS=/tmp/cleanws2
cd "$WS" || exit 1
# shellcheck disable=SC1091
source /opt/ros/jazzy/setup.bash
# shellcheck disable=SC1091
source install/setup.bash

echo "=== phase2: proto + proto_cli + bt + ros + tools（修复后的列表）==="
colcon build --base-paths . --symlink-install \
  --packages-select amr_dispatcher_proto amr_dispatcher_proto_cli \
                   amr_dispatcher_bt amr_dispatcher_ros amr_dispatcher_tools \
  --cmake-args -DCMAKE_BUILD_TYPE=Release 2>&1 | tail -20

echo
echo "=== install/ 下的包 ==="
find install -maxdepth 1 -type d -name 'amr_dispatcher_*' | sort

echo
echo "=== ros2 amr echo 是否可用（修好后应出现在 PATH 里）==="
# shellcheck disable=SC1091
source install/setup.bash
ros2 pkg executables amr_dispatcher_proto_cli 2>&1 | head -3
