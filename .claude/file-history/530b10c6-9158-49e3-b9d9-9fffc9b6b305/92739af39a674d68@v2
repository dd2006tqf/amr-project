# ============================================================================
# cmake/toolchain-arm64-cross.cmake
# 原生交叉编译工具链配置（x86_64 宿主机 -> aarch64 目标机）
#
# 原理：
# 1. 编译器本身使用宿主机原生 aarch64-linux-gnu-gcc / g++（以 x86 原生指令集运行，
#    可打满全部 CPU 核心并行编译 -j$(nproc)，无需 QEMU 模拟）。
# 2. 目标依赖库与头文件（libdbus, libnl, sqlite3, glibc 2.31 等）指向
#    /opt/sysroot-bullseye-arm64，保证与开发板 (Debian 11 Bullseye) 运行时二进制绝对兼容。
# ============================================================================

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

# 目标编译器定义
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)

# 目标 Sysroot
set(SYSROOT_DIR "/opt/sysroot-bullseye-arm64")
set(CMAKE_SYSROOT ${SYSROOT_DIR})
set(CMAKE_FIND_ROOT_PATH ${SYSROOT_DIR})

# 告知 generate_vmlinux.sh 我们正在针对 aarch64 交叉编译
set(ENV{TARGET_ARCH} "aarch64")

# 资源搜索隔离策略
# 可执行文件只在宿主机找（如 clang, make, pkg-config）
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
# 头文件、库文件只在 sysroot 中找，严禁捡起宿主机的 x86 库
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# 全局默认头文件与库搜索路径包含 /usr/local（libbpf 位于 /usr/local）
include_directories(SYSTEM "${SYSROOT_DIR}/usr/local/include")
link_directories("${SYSROOT_DIR}/usr/local/lib" "${SYSROOT_DIR}/usr/lib/aarch64-linux-gnu")

# Pkg-config 交叉编译环境变量注入
set(ENV{PKG_CONFIG_DIR} "")
set(ENV{PKG_CONFIG_LIBDIR} "${SYSROOT_DIR}/usr/lib/aarch64-linux-gnu/pkgconfig:${SYSROOT_DIR}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SYSROOT_DIR}")

# 私有依赖路径映射
set(WEAKNET_OPENSSL_SYSROOT "${SYSROOT_DIR}/opt/weaknet-openssl-1.1" CACHE PATH "" FORCE)
set(WEAKNET_CURL_SYSROOT "${SYSROOT_DIR}/opt/weaknet-libcurl" CACHE PATH "" FORCE)
