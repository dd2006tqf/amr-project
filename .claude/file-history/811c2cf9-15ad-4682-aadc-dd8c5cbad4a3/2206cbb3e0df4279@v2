// 直播模块配置常量

#pragma once

#include <cstdint>

namespace ins {
namespace live_broadcast {
namespace config {

// ============================================================================
// 线程池配置
// ============================================================================

/// 线程池大小
/// @details 用于异步任务处理（如网络重连、资源清理等）
/// @note 选择4是因为直播模块主要任务包括：
///       1. 视频流读取  2. 音频流读取  3. RTMP推送  4. 监控/定时任务
/// @note 可调范围：2-8，根据实际负载和设备性能调整
/// @note 未来可通过运行时配置覆盖（TODO(yinjun|2025-12-30)）
constexpr int32_t kThreadPoolSize = 4;

// ============================================================================
// 队列配置
// ============================================================================

/// 视频帧队列容量（约3秒缓冲，按30fps计算）
constexpr int32_t kVideoQueueCapacity = 90;

/// 音频帧队列容量（约3秒缓冲，按50fps计算）
constexpr int32_t kAudioQueueCapacity = 150;

// ============================================================================
// 超时配置
// ============================================================================

/// RTMP连接超时（毫秒）
constexpr int32_t kRtmpConnectTimeoutMs = 10000;

/// WIFI连接超时（毫秒）
constexpr int32_t kWifiConnectTimeoutMs = 30000;

/// 重连间隔基础值（毫秒，指数退避）
constexpr int32_t kReconnectBaseIntervalMs = 1000;

/// 最大重连次数
constexpr int32_t kMaxReconnectAttempts = 5;

// ============================================================================
// 监控配置
// ============================================================================

/// 状态上报周期（毫秒）
constexpr int32_t kStateReportIntervalMs = 1000;

/// 时长更新周期（秒）
constexpr int32_t kDurationUpdateIntervalSec = 1;

// ============================================================================
// 监控与码率自适应配置
// ============================================================================

/// 监控 tick 周期（毫秒，1 秒）
constexpr int32_t kMonitorTickIntervalMs = 1000;

/// 目标帧率（fps，ABR 低帧/高帧判定基准）
constexpr int32_t kLiveTargetFps = 30;

/// 当前码率档位初始值（kbps，接入 mediad 码率 RPC 后由实际档位覆盖）
constexpr int32_t kLiveDefaultBitrateKbps = 8000;

/// 最高码率档位（kbps）
constexpr int32_t kLiveMaxBitrateKbps = 12000;

/// 最低码率档位（kbps，降码率下限）
constexpr int32_t kLiveMinBitrateKbps = 1000;

/// 低帧率持续 tick 数（约等于秒数）达到后才触发降码率，防抖
constexpr int32_t kMonitorLowFpsPersistTicks = 5;

/// 帧率回稳持续 tick 数达到后才触发升码率，防抖（迟滞大于降码率，
/// 避免在阈值附近震荡）
constexpr int32_t kMonitorRecoverFpsPersistTicks = 10;

/// 推流停摆判定：连续 N 个 tick 无视频帧发送成功则上报网络错误，
/// 触发状态机断流恢复（重连闭环）
constexpr int32_t kMonitorStallTicksThreshold = 10;

}  // namespace config
}  // namespace live_broadcast
}  // namespace ins
