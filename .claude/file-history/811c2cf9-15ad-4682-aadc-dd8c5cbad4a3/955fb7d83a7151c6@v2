InsErrorCode LiveBroadcastManager::RequestRtmpReconnect() {
  if (GetCurrentState() != LiveBroadcastState::kRunning) {
    ILOGS_W << "reconnect rejected: not in Running (current "
            << static_cast<int32_t>(GetCurrentState()) << ")";
    return kInsErrorCode_Comm_Einval;
  }
  if (reconnect_in_flight_.exchange(true, std::memory_order_acq_rel)) {
    // 已有重连在途：由其回投结果驱动后续判定，避免两个连接线程并发操作
    // 同一个 pusher
    return kInsErrorCode_Comm_Ealready;
  }

  const std::string rtmp_url =
      config_manager_ ? config_manager_->GetRtmpUrl() : std::string{};
  std::shared_ptr<RtmpPusher> pusher = GetLiveBroadcastRtmpPusher();
  if (rtmp_url.empty() || !pusher) {
    ILOGS_E << "reconnect rejected: url " << (rtmp_url.empty() ? "empty" : "ok")
            << ", pusher " << (pusher ? "ok" : "null");
    reconnect_in_flight_.store(false, std::memory_order_release);
    return kInsErrorCode_Comm_Einval;
  }

  // 上一轮启动连接线程对象可能尚未回收，先做非阻塞收尾（其早已执行完毕，
  // JoinFor(0) 立即成功）；避免覆盖 connect_thread_ 时旧对象析构隐式 Join
  WaitConnectThreadFinished(0);

  const uint64_t attempt_id = BeginStartAttempt();
  std::weak_ptr<LiveBroadcastManager> weak_mgr = weak_from_this();
  const bool started =
      StartConnectThread([weak_mgr, pusher, rtmp_url, attempt_id]() {
        // 旧会话可能仍在半开状态，先断开再重连
        pusher->Disconnect();
        InsErrorCode err = pusher->Connect(rtmp_url);
        auto mgr = weak_mgr.lock();
        if (!mgr) {
          // Stop/Shutdown 已开始；不再回投，线程内自行收尾
          pusher->Disconnect();
          return;
        }
        std::string msg = (err != kInsErrorCode_Comm_Success)
                              ? ins::errc::GetInsErrorCodeString(err)
                              : "";
        mgr->PostStartResult(attempt_id, err, msg);
      });
  if (!started) {
    ILOGS_E << "reconnect: start connect thread failed";
    reconnect_in_flight_.store(false, std::memory_order_release);
    return kInsErrorCode_Comm_Failure;
  }
  ILOGS_I << "RTMP reconnect submitted, attempt_id=" << attempt_id;
  return kInsErrorCode_Comm_Success;
}

