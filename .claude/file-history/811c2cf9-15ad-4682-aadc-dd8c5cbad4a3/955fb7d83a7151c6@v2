InsErrorCode LiveBroadcastManager::OnDispatchPrepare(const int32_t& req) {
  static_cast<void>(req);
  const LiveBroadcastState state = GetCurrentState();
  if (state != LiveBroadcastState::kIdle &&
      state != LiveBroadcastState::kPrepare) {
    ILOGS_W << "Prepare rejected on work thread: invalid state "
            << static_cast<int32_t>(state);
    return kInsErrorCode_Comm_Einval;
  }
  LiveStateMachine::DispatchEvent(EventPrepareRequest{});
  return kInsErrorCode_Comm_Success;
}

InsErrorCode LiveBroadcastManager::OnDispatchStart(const int32_t& req) {
  static_cast<void>(req);
  if (GetCurrentState() != LiveBroadcastState::kPrepare) {
    ILOGS_W << "RequestStart rejected on work thread: not in Prepare (current "
            << static_cast<int32_t>(GetCurrentState()) << ")";
    return kInsErrorCode_Comm_Einval;
  }
  EventStartRequest evt;
  evt.rtmp_url = config_manager_->GetRtmpUrl();
  LiveStateMachine::DispatchEvent(evt);
  return kInsErrorCode_Comm_Success;
}

InsErrorCode LiveBroadcastManager::OnDispatchStop(const int32_t& req) {
  const LiveBroadcastState state = GetCurrentState();
  if (state == LiveBroadcastState::kIdle) {
    ILOGS_W << "StopBroadcast rejected on work thread: already Idle";
    return kInsErrorCode_Comm_Einval;
  }
  if (state == LiveBroadcastState::kStopping) {
    ILOGS_W << "StopBroadcast rejected on work thread: already Stopping";
    return kInsErrorCode_Comm_Ealready;
  }
  EventStopRequest evt;
  evt.reason = static_cast<LiveBroadcastStopReason>(req);
  LiveStateMachine::DispatchEvent(evt);
  return kInsErrorCode_Comm_Success;
}

