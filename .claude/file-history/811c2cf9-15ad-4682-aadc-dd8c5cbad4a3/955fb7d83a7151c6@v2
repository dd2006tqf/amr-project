LiveBroadcastManager::LiveBroadcastManager(
    const std::shared_ptr<ins::base::MsgLooper>& main_msglooper,
    std::shared_ptr<ins::base::ThreadPool> thread_pool)
    : main_msg_looper_(main_msglooper),
      work_msg_looper_(
          std::make_shared<ins::base::MsgLooper>("LiveBroadcastWork")),
      thread_pool_(std::move(thread_pool)),
      current_state_(LiveBroadcastState::kIdle) {
  ILOGS_I << "LiveBroadcastManager created";
}

InsErrorCode LiveBroadcastManager::StartLiveBroadcastManager() {
  ILOGS_I << "Starting LiveBroadcastManager";

  // 先复位Hook，保证幂等性（防止重复Start时残留旧回调）
  LiveStateMachine::SetStateChangeHook(nullptr);

  // 设置状态变化Hook，使用weak_ptr保护生命周期
  LiveStateMachine::SetStateChangeHook(
      [weak = weak_from_this()](LiveBroadcastState state) {
        if (auto self = weak.lock()) {
          self->HandleStateChange(state);
        }
      });

  // 注册状态机启动事件
  InsErrorCode reg_ret = work_msg_looper_->RegisterHandler<void, int32_t>(
      MessageIds::kStateMachineStart,  // 状态机启动事件ID
      &LiveBroadcastManager::OnStateMachineStart, this);
  if (reg_ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to register handler: "
            << ins::errc::GetInsErrorCodeString(reg_ret) << " (" << reg_ret
            << ")";
    return reg_ret;
  }

  // 注册 RPC 触发的状态机派发事件（带响应：在工作线程内做状态判定并返回
  // InsErrorCode）
  auto reg_dispatch_resp = [this](int32_t id,
                                  InsErrorCode (LiveBroadcastManager::*handler)(
                                      const int32_t&)) -> bool {
    InsErrorCode ec = work_msg_looper_->RegisterHandler<InsErrorCode, int32_t>(
        id, handler, this);
    if (ec != kInsErrorCode_Comm_Success) {
      ILOGS_E << "Failed to register dispatch response handler id=" << id;
      return false;
    }
    return true;
  };
  if (!reg_dispatch_resp(MessageIds::kDispatchPrepare,
                         &LiveBroadcastManager::OnDispatchPrepare) ||
      !reg_dispatch_resp(MessageIds::kDispatchStart,
                         &LiveBroadcastManager::OnDispatchStart) ||
      !reg_dispatch_resp(MessageIds::kDispatchStop,
                         &LiveBroadcastManager::OnDispatchStop) ||
      !reg_dispatch_resp(MessageIds::kDispatchResume,
                         &LiveBroadcastManager::OnDispatchResume) ||
      !reg_dispatch_resp(MessageIds::kDispatchDiscardResume,
                         &LiveBroadcastManager::OnDispatchDiscardResume)) {
    return kInsErrorCode_Comm_Einval;
  }
  // 仅内部使用的 void 派发（WIFI 连接成功等）
  InsErrorCode prep_complete_ec =
      work_msg_looper_->RegisterHandler<void, int32_t>(
          MessageIds::kDispatchPrepareComplete,
          &LiveBroadcastManager::OnDispatchPrepareComplete, this);
  if (prep_complete_ec != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to register kDispatchPrepareComplete handler";
    return kInsErrorCode_Comm_Einval;
  }
  InsErrorCode start_result_ec =
      work_msg_looper_->RegisterHandler<void, StartResultPayload>(
          MessageIds::kDispatchStartResult,
          &LiveBroadcastManager::OnDispatchStartResult, this);
  if (start_result_ec != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to register kDispatchStartResult handler";
    return kInsErrorCode_Comm_Einval;
  }

  // 同步初始化状态机依赖，失败则直接返回，避免半初始化状态
  InsErrorCode init_ret = InitStateMachineDependencies();
  if (init_ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to init state machine dependencies: "
            << ins::errc::GetInsErrorCodeString(init_ret) << " (" << init_ret
            << ")";
    return init_ret;
  }

  // 启动工作MsgLooper
  InsErrorCode start_ret = work_msg_looper_->Start();
  if (start_ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to start work_msg_looper: "
            << ins::errc::GetInsErrorCodeString(start_ret) << " (" << start_ret
            << ")";
    ClearStateMachineStaticRefs();
    return start_ret;
  }

  // 投递状态机启动事件（仅启动状态机，依赖已在上面完成）
  InsErrorCode post_ret =
      work_msg_looper_->Post<void>(MessageIds::kStateMachineStart, 0);
  if (post_ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to post start event: "
            << ins::errc::GetInsErrorCodeString(post_ret) << " (" << post_ret
            << ")";
    InsErrorCode stop_ret = work_msg_looper_->Stop();
    if (stop_ret != kInsErrorCode_Comm_Success &&
        stop_ret != kInsErrorCode_Comm_Edeadlk) {
      ILOGS_E << "Failed to stop work_msg_looper after post failure: "
              << ins::errc::GetInsErrorCodeString(stop_ret);
    }
    ClearStateMachineStaticRefs();
    return post_ret;
  }

  ILOGS_I << "LiveBroadcastManager started";
  return kInsErrorCode_Comm_Success;
}

void LiveBroadcastManager::RequestGoToIdleAndWait(uint32_t timeout_ms) {
  if (GetCurrentState() == LiveBroadcastState::kIdle) {
    return;
  }
  const auto result = work_msg_looper_->PostAndWaitResponse<InsErrorCode>(
      MessageIds::kDispatchStop,
      static_cast<int32_t>(LiveBroadcastStopReason::kUserStop));
  if (!result.has_value()) {
    ILOGS_W << "PostAndWaitResponse(Stop) failed or "
               "timed out";
  }
  const std::chrono::milliseconds poll_interval(100);
  const std::chrono::milliseconds total(timeout_ms);
  auto elapsed = std::chrono::milliseconds(0);
  while (elapsed < total) {
    if (GetCurrentState() == LiveBroadcastState::kIdle) {
      ILOGS_I << "state reached Idle";
      return;
    }
    std::this_thread::sleep_for(poll_interval);
    elapsed += poll_interval;
  }
  ILOGS_W << "timed out after " << timeout_ms << " ms without reaching Idle";
}

void LiveBroadcastManager::StopLiveBroadcastManager() {
  ILOGS_I << "Stopping LiveBroadcastManager";
  LiveStateMachine::Stop();
  LiveStateMachine::SetStateChangeHook(nullptr);
  const InsErrorCode stop_ret = work_msg_looper_->Stop();
  if (stop_ret != kInsErrorCode_Comm_Success &&
      stop_ret != kInsErrorCode_Comm_Edeadlk) {
    ILOGS_E << "work_msg_looper_ Stop() returned: "
            << ins::errc::GetInsErrorCodeString(stop_ret) << " (" << stop_ret
            << ")";
  }
  // 若连接线程未被 Stopping 状态清理（异常路径），在此统一 Detach 并释放，
  // 避免析构时 joinable 导致阻塞。
  if (connect_thread_) {
    const InsErrorCode detach_ret = connect_thread_->Detach();
    if (detach_ret != kInsErrorCode_Comm_Success) {
      ILOGS_W << "Connect thread Detach in StopManager returned: "
              << ins::errc::GetInsErrorCodeString(detach_ret);
    }
    connect_thread_.reset();
  }
  ClearStateMachineStaticRefs();
  ILOGS_I << "LiveBroadcastManager stopped";
}

void LiveBroadcastManager::ClearStateMachineStaticRefs() {
  LiveStateMachine::SetManager(nullptr);
  LiveStateMachine::SetResumeManager(nullptr);
  LiveStateMachine::SetConfigManager(nullptr);
  LiveStateMachine::SetNetworkController(nullptr);
  LiveStateMachine::SetStreamController(nullptr);
}

