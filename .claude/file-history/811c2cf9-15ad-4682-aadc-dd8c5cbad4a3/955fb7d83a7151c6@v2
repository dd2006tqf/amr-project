void LiveBroadcastManager::OnDispatchPrepareComplete(const int32_t& req) {
  static_cast<void>(req);
  LiveStateMachine::DispatchEvent(EventPrepareComplete{});
}

void LiveBroadcastManager::PostStartResult(uint64_t attempt_id,
                                           InsErrorCode err,
                                           const std::string& message) {
  StartResultPayload payload;
  payload.attempt_id = attempt_id;
  payload.err = err;
  payload.message = message;
  InsErrorCode ret = work_msg_looper_->Post<void, StartResultPayload>(
      MessageIds::kDispatchStartResult, std::move(payload));
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "failed: " << ins::errc::GetInsErrorCodeString(ret);
  }
}

void LiveBroadcastManager::OnDispatchStartResult(StartResultPayload& payload) {
  const uint64_t active_attempt =
      active_start_attempt_.load(std::memory_order_acquire);
  if (payload.attempt_id != active_attempt) {
    ILOGS_W << "Ignore stale start result, payload attempt="
            << payload.attempt_id << ", active attempt=" << active_attempt;
    // 过期结果也意味着其提交线程已回投完毕；若该结果属于在途重连
    // （如停播后重启，重连结果迟到被丢弃），顺带复位在途标志，
    // 避免新一场直播的重连被 Ealready 永久拒绝
    if (reconnect_in_flight_.load(std::memory_order_acquire)) {
      reconnect_in_flight_.store(false, std::memory_order_release);
    }
    return;
  }
  // 活跃attempt的结果必然来自当前在途连接/重连任务，复位在途标志
  reconnect_in_flight_.store(false, std::memory_order_release);

  const LiveBroadcastState state = GetCurrentState();

  // ========== Running分支：本次结果属于 RequestRtmpReconnect 的重连任务 ==========
  if (state == LiveBroadcastState::kRunning) {
    std::shared_ptr<RtmpPusher> pusher = GetLiveBroadcastRtmpPusher();
    const bool connect_ok =
        (payload.err == kInsErrorCode_Comm_Success) && pusher;
    InsErrorCode start_ret = kInsErrorCode_Comm_Success;
    if (connect_ok) {
      start_ret = pusher->Start();  // 重连成功后重新拉起推流线程
    }
    if (!connect_ok || start_ret != kInsErrorCode_Comm_Success) {
      const std::string msg =
          connect_ok ? ins::errc::GetInsErrorCodeString(start_ret)
                     : (payload.message.empty() ? "reconnect: connect failed"
                                                : payload.message);
      ILOGS_W << "RTMP reconnect failed: " << msg;
      ReportLiveBroadcastErrorCode(LiveBroadcastErrorCode::kNetworkError);
      if (pusher) {
        pusher->Disconnect();
      }
      // 回投工作线程：Running累计重连次数，超阈值保存续播记录并转Stopping
      LiveStateMachine::DispatchEvent(
          EventError{{}, LiveBroadcastErrorCode::kNetworkError, msg});
      return;
    }
    ILOGS_I << "RTMP reconnect succeeded, attempt_id=" << payload.attempt_id;
    LiveStateMachine::DispatchEvent(EventNetworkRecovered{});
    return;
  }

  if (state != LiveBroadcastState::kStarting) {
    ILOGS_W << "current state is not Starting";
    return;  // 忽略过期结果（如已转 Stopping）
  }
  // TODO(lianxingwang|2026-03-18):  把明确属于网络/传输的问题映射为
  // kNetworkError，把配置/参数/资源（如 InvalidUrl / OutOfMemory /
  // StartFailed）映射为 kSystemError 或新增更细粒度的错误码；
  if (payload.err != kInsErrorCode_Comm_Success) {
    LiveBroadcastErrorCode report_code =
        (payload.err >= kInsErrorCode_Range_MediadMin &&
         payload.err <= kInsErrorCode_Range_MediadMax)
            ? LiveBroadcastErrorCode::kSystemError
            : LiveBroadcastErrorCode::kNetworkError;
    ReportLiveBroadcastErrorCode(report_code);
    std::shared_ptr<RtmpPusher> pusher = GetLiveBroadcastRtmpPusher();
    if (pusher) {
      pusher->Disconnect();
    }
    SetLiveBroadcastRtmpPusher(nullptr);
    LiveStateMachine::DispatchEvent(
        EventStartFailed{{}, report_code, payload.message});
    return;
  }
  std::shared_ptr<RtmpPusher> pusher = GetLiveBroadcastRtmpPusher();
  if (!pusher) {
    ILOGS_E << "pusher is null after connect success";
    return;
  }
  InsErrorCode start_ret = pusher->Start();
  if (start_ret != kInsErrorCode_Comm_Success) {
    LiveBroadcastErrorCode report_code =
        (start_ret >= kInsErrorCode_Range_MediadMin &&
         start_ret <= kInsErrorCode_Range_MediadMax)
            ? LiveBroadcastErrorCode::kSystemError
            : LiveBroadcastErrorCode::kNetworkError;
    ILOGS_E << "RTMP Start failed: "
            << ins::errc::GetInsErrorCodeString(start_ret);
    ReportLiveBroadcastErrorCode(report_code);
    pusher->Disconnect();
    SetLiveBroadcastRtmpPusher(nullptr);
    LiveStateMachine::DispatchEvent(EventStartFailed{
        {}, report_code, ins::errc::GetInsErrorCodeString(start_ret)});
    return;
  }
  LiveStateMachine::DispatchEvent(EventStartSuccess{});
}

