uint64_t LiveBroadcastManager::BeginStartAttempt() {
  const uint64_t attempt_id =
      start_attempt_seq_.fetch_add(1, std::memory_order_relaxed) + 1;
  active_start_attempt_.store(attempt_id, std::memory_order_release);
  return attempt_id;
}

