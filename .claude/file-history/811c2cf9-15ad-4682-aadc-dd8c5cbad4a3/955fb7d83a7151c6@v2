void LiveBroadcastManager::OnConfigUpdate(
    const std::vector<::ins::config::ConfigKey>& changed_configs) {
  const bool has_live_broadcast =
      std::find(changed_configs.begin(), changed_configs.end(),
                ::ins::config::ConfigKey::kLiveBroadcast) !=
      changed_configs.end();
  if (has_live_broadcast && config_manager_) {
    config_manager_->OnConfigChanged(GetCurrentState());
  }
  ILOGS_D << "OnConfigUpdate, count=" << changed_configs.size();
}

void LiveBroadcastManager::OnWifiStaOn(
    ::ins::ibus::common::netd::WifiConnectionResult error_code,
    const ::ins::ibus::common::netd::WifiInfo& wifi_info) {
  static_cast<void>(wifi_info);
  ILOGS_D << "OnWifiStaOn, error_code=" << static_cast<int32_t>(error_code);
  // WIFI 连接成功时投递 EventPrepareComplete 到状态机，由 Prepare 切换到
  // Starting
  if (error_code ==
      ::ins::ibus::common::netd::WifiConnectionResult::kConnectSuccess) {
    InsErrorCode ret =
        work_msg_looper_->Post<void>(MessageIds::kDispatchPrepareComplete, 0);
    if (ret != kInsErrorCode_Comm_Success) {
      ILOGS_E << "Post PrepareComplete failed: "
              << ins::errc::GetInsErrorCodeString(ret);
    }
  }
}

