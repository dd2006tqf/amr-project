/*连接线程（StartConnectThread 启动的线程）与 Stop/Shutdown 路径对同一
RtmpPusher/RtmpSession 不存在并发变更 先 RequestCancelConnect()，再
WaitConnectThreadFinished()；只有在线程已结束时才会执行
pusher->Stop()/Disconnect()，而超时分支不会再触碰 pusher，只做
SetLiveBroadcastRtmpPusher(nullptr)。
*/
bool LiveBroadcastManager::StartConnectThread(std::function<void()> task) {
  std::function<void()> t = std::move(task);
  auto thread =
      std::make_shared<ins::base::Thread>("LiveBroadcastConnect", [t]() {
        t();
        return false;  // 单次执行后退出循环
      });
  const InsErrorCode ret = thread->Start();
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to start connect thread: "
            << ins::errc::GetInsErrorCodeString(ret);
    return false;
  }
  connect_thread_ = std::move(thread);
  return true;
}

bool LiveBroadcastManager::WaitConnectThreadFinished(int64_t timeout_ms) {
  if (!connect_thread_) {
    return true;
  }
  // 不将 connect_thread_ 移到局部变量：否则超时分支返回时局部 Thread 析构会
  // 隐式 Join，导致超时上限失效并可能死等。超时时对 connect_thread_ 显式
  // Detach 后再 reset，保证在给定 timeout_ms 内返回。
  const InsErrorCode ret =
      connect_thread_->JoinFor(ins::base::ms2ns(ins::base::stdms(timeout_ms)));
  if (ret == kInsErrorCode_Comm_Success) {
    connect_thread_.reset();
    return true;
  }
  if (ret != kInsErrorCode_Comm_Etimedout) {
    ILOGS_W << "Connect thread JoinFor returned: "
            << ins::errc::GetInsErrorCodeString(ret);
  }
  if (ret == kInsErrorCode_Comm_Etimedout) {
    ILOGS_W << "Connect thread wait timed out, detach and continue with stop";
  }
  // 超时或其它失败：Detach 后 reset，避免析构时隐式 Join 阻塞。
  const InsErrorCode detach_ret = connect_thread_->Detach();
  if (detach_ret != kInsErrorCode_Comm_Success) {
    ILOGS_W << "Connect thread Detach returned: "
            << ins::errc::GetInsErrorCodeString(detach_ret);
  }
  connect_thread_.reset();
  return false;
}

