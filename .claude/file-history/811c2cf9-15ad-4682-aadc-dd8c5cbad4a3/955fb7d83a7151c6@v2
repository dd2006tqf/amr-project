void LiveBroadcastManager::OnStateMachineStart(const int32_t& req) {
  static_cast<void>(req);
  ILOGS_I << "Starting state machine (dependencies already initialized)";

  // 依赖已在 StartLiveBroadcastManager() 中同步初始化，此处仅启动状态机
  LiveStateMachine::Start();

  ILOGS_I << "State machine started";
}

InsErrorCode LiveBroadcastManager::InitStateMachineDependencies() {
  stream_controller_ = std::make_shared<StreamController>();
  InsErrorCode ret = stream_controller_->Initialize();
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "StreamController Initialize failed: "
            << ins::errc::GetInsErrorCodeString(ret);
    stream_controller_.reset();
    return ret;
  }
  LiveStateMachine::SetStreamController(stream_controller_);

  network_controller_ = std::make_shared<NetworkController>();
  ret = network_controller_->Initialize();
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "NetworkController Initialize failed: "
            << ins::errc::GetInsErrorCodeString(ret);
    LiveStateMachine::SetStreamController(nullptr);
    stream_controller_.reset();
    network_controller_.reset();
    return ret;
  }
  LiveStateMachine::SetNetworkController(network_controller_);

  config_manager_ = std::make_shared<ConfigManager>();
  ret = config_manager_->Initialize();
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "ConfigManager Initialize failed: "
            << ins::errc::GetInsErrorCodeString(ret);
    LiveStateMachine::SetNetworkController(nullptr);
    LiveStateMachine::SetStreamController(nullptr);
    network_controller_.reset();
    stream_controller_.reset();
    config_manager_.reset();
    return ret;
  }
  LiveStateMachine::SetConfigManager(config_manager_);
  stream_controller_->SetConfigManager(config_manager_);

  resume_manager_ = std::make_shared<ResumeManager>();
  ret = resume_manager_->Initialize();
  if (ret != kInsErrorCode_Comm_Success) {
    ILOGS_E << "ResumeManager Initialize failed: "
            << ins::errc::GetInsErrorCodeString(ret);
    LiveStateMachine::SetConfigManager(nullptr);
    LiveStateMachine::SetNetworkController(nullptr);
    LiveStateMachine::SetStreamController(nullptr);
    config_manager_.reset();
    network_controller_.reset();
    stream_controller_.reset();
    resume_manager_.reset();
    return ret;
  }
  LiveStateMachine::SetResumeManager(resume_manager_);

  LiveStateMachine::SetManager(shared_from_this());
  ILOGS_I << "State machine dependencies initialized";
  return kInsErrorCode_Comm_Success;
}

void LiveBroadcastManager::HandleStateChange(LiveBroadcastState state) {
  {
    ins::base::AutoMutex lock(state_mutex_);
    ILOGS_I << "HandleStateChange: " << magic_enum::enum_name(current_state_)
            << " -> " << magic_enum::enum_name(state);

    // 成功进入 Prepare（新一次准备）或 Running（启动成功）时重置最近错误码，与
    // Topic 语义一致
    if (state == LiveBroadcastState::kPrepare ||
        state == LiveBroadcastState::kRunning) {
      current_error_.store(LiveBroadcastErrorCode::kNone);
    }

    // 更新本地状态快照
    current_state_ = state;
  }

  // 1. 更新ShareState（实时同步）
  UpdateShareState(state);

  // 2. 发布ibus Topic（线程安全）
  PublishStateChanged(state);

  // 3. 通知主线程（如果需要）
  NotifyMainLooper(state);
}

void LiveBroadcastManager::UpdateShareState(LiveBroadcastState state) {
  // 更新ShareState（实时同步到共享内存）
  int32_t ret = ins::share_state::LiveBroadcastSsMgr::GetInstance()
                    .SetLiveBroadcastSharedStatus(
                        [state](auto& live) { live.broadcast_state = state; });

  if (ret != 0) {
    ILOGS_E << "Failed to update ShareState: segment="
            << typeid(ins::share_state::LiveBroadcastSsWrapper).name()
            << ", error_code=" << ret
            << " (check /proc/[pid]/comm matches 'ins_livecast' and write "
               "permission)";
  } else {
    ILOGS_D << "Updated ShareState to: " << magic_enum::enum_name(state);
  }
}

void LiveBroadcastManager::PublishStateChanged(LiveBroadcastState state) {
  ins::ibus::camera::live_broadcast::LiveBroadcastPublishService::GetInstance()
      .PublishLiveBroadcastStateChanged(state);

  ILOGS_I << "Published StateChanged topic: " << magic_enum::enum_name(state);
}
