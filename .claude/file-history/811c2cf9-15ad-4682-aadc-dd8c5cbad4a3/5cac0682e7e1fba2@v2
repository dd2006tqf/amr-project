// 配置管理器

#pragma once

#include <memory>
#include <string>

#include "ins_base/mutex.h"
#include "ins_config/live_broadcast.h"
#include "ins_config/media_video.h"
#include "ins_config/media_video_enum.h"
#include "ins_error_code/ins_errorcode.h"
#include "service/live_broadcast_types.h"

namespace ins {
namespace live_broadcast {

// 直接复用配置定义，避免与 ins_config_definitions 中的结构体长期漂移
using LiveBroadcastConfig = ::ins::config::LiveBroadcastConfig;

/**
 * @brief 配置管理器
 * @details 负责从configd读取配置和监听配置变更，为直播模块提供唯一配置源。
 *          根据顶层设计文档要求：
 *          - ins_acc负责写入配置（通过proto消息）
 *          - ins_live_broadcast只读取配置和监听变更
 *          - 续播记录的写入由ResumeManager负责
 *          直播模块应统一通过 GetConfig() 获取当前配置，配置变更后通过
 *          OnConfigChanged 重载后即可拿到最新配置。
 * @note 不可复制，仅可移动（管理外部资源连接）
 */
class ConfigManager {
 public:
  ConfigManager();
  ~ConfigManager();

  // 禁止拷贝
  ConfigManager(const ConfigManager&) = delete;
  ConfigManager& operator=(const ConfigManager&) = delete;

  // 允许移动
  ConfigManager(ConfigManager&&) = default;
  ConfigManager& operator=(ConfigManager&&) = default;

  /**
   * @brief 初始化配置管理器
   * @details 从configd读取初始配置并订阅ConfigChanged Topic
   * @return kInsErrorCode_Comm_Success 成功
   */
  InsErrorCode Initialize();

  /**
   * @brief 获取当前配置的快照（只读）
   * @return 当前直播配置的 shared_ptr 快照；调用方持有该指针可安全访问，
   *         生命周期与 LoadConfigFromConfigd 的原子替换互不干扰，避免悬垂引用。
   */
  std::shared_ptr<const LiveBroadcastConfig> GetConfig() const;

  /**
   * @brief 配置变更回调处理
   * @details 由 Manager::OnConfigUpdate 在收到 Config Topic
   * 变更时调用，调用方传入当前直播状态
   *          - 状态为 kRunning 时：不允许重载，仅记录日志
   *          - 非 kRunning 时：立即重新加载配置
   * @param current_state 当前直播状态（由调用方通过 GetCurrentState()
   * 等直接获取并传入）
   */
  void OnConfigChanged(LiveBroadcastState current_state);

  /**
   * @brief 获取RTMP推流地址
   * @return RTMP推流地址
   */
  std::string GetRtmpUrl() const;

  /**
   * @brief 获取上次连接的WiFi SSID（进入Running时由SaveConnectedWifiSsid落盘）
   * @return SSID字符串；无记录或记录非法时返回空串
   */
  std::string GetLastConnectedSsid() const;

  /**
   * @brief 保存连接的WiFi信息 SSID 到配置
   * @return InsErrorCode
   */
  InsErrorCode SaveConnectedWifiSsid();

 private:
  /**
   * @brief 从configd读取配置
   * @return InsErrorCode
   */
  InsErrorCode LoadConfigFromConfigd();

  // 成员变量
  mutable ins::base::Mutex config_mutex_;  ///< 保护 current_config_ 的读写
  std::shared_ptr<LiveBroadcastConfig>
      current_config_;  ///< 当前配置（由 configd 加载，重载时原子替换）
};

}  // namespace live_broadcast
}  // namespace ins
