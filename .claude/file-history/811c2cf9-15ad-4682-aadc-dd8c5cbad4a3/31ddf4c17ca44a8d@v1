constexpr int kMaxRtmpPacketAllocSize =
    std::numeric_limits<int>::max() - RTMP_MAX_HEADER_SIZE;

bool FillRtmpPacketMeta(StreamPacketType packet_type,
                        RtmpPacketHolder* holder) {
  if (holder == nullptr) {
    return false;
  }

  switch (packet_type) {
    case StreamPacketType::kVideo:
      holder->pkt.m_packetType = static_cast<uint8_t>(RtmpPacketType::kVideo);
      holder->pkt.m_nChannel = static_cast<int>(RtmpChannelId::kVideo);
      holder->pkt.m_headerType = RTMP_PACKET_SIZE_LARGE;
      return true;
    case StreamPacketType::kAudio:
      holder->pkt.m_packetType = static_cast<uint8_t>(RtmpPacketType::kAudio);
      holder->pkt.m_nChannel = static_cast<int>(RtmpChannelId::kAudio);
      holder->pkt.m_headerType = RTMP_PACKET_SIZE_MEDIUM;
      return true;
    default:
      ILOGS_E << "Unsupported stream packet type: "
              << static_cast<int>(packet_type);
      return false;
  }
}

}  // namespace

RtmpPusher::RtmpPusher()
    : rtmp_session_(std::make_unique<RtmpSession>()),
      stream_reader_(nullptr),
      push_thread_(nullptr) {}

RtmpPusher::~RtmpPusher() {
  Stop();
  Disconnect();
}

InsErrorCode RtmpPusher::Connect(const std::string& rtmp_url) {
  if (!rtmp_session_) {
    try {
      rtmp_session_ = std::make_unique<RtmpSession>();
    } catch (const std::bad_alloc& e) {
      ILOGS_E << "Failed to create rtmp session: " << e.what();
      return kInsErrorCode_LiveBroadcast_OutOfMemory;
    }
  }

  if (rtmp_session_->IsConnected()) {
    ILOGS_I << "rtmp_session_ is already connected";
    return kInsErrorCode_Comm_Success;
  }

  InsErrorCode result = rtmp_session_->Connect(rtmp_url);
  if (result == kInsErrorCode_Comm_Success) {
    ILOGS_I << "rtmp_session_ connected successfully";
  }
  return result;
}

void RtmpPusher::Disconnect() {
  Stop();
  if (!rtmp_session_) {
    ILOGS_E << "rtmp_session_ is null";
    return;
  }
  rtmp_session_->Reset();
}

bool RtmpPusher::Run() {
  if (!rtmp_session_) {
    ILOGS_E << "rtmp_session_ is null";
    is_running_.store(false);
    return false;
  }

  if (!is_running_) {
    return false;
  }

  if (!stream_reader_) {
    is_running_.store(false);
    return false;
  }

  StreamDataPacket packet;
  InsErrorCode result =
      stream_reader_->GetFrameBlocking(packet, kStreamReaderTimeoutMs);
  if (result != kInsErrorCode_Comm_Success &&
      result != kInsErrorCode_LiveBroadcast_NoReadableData) {
    ILOGS_E << "Failed to get frame, error: " << result;
    is_running_.store(false);
    return false;
  }

  if (packet.payload.empty()) {
    // 超时 / 空队列：本轮没数据，让上层继续轮询
    return true;
  }

  if (packet.payload.size() > static_cast<size_t>(kMaxRtmpPacketAllocSize)) {
    ILOGS_E << "RTMP payload too large, size=" << packet.payload.size()
            << " max=" << kMaxRtmpPacketAllocSize;
    return true;
  }

  RtmpPacketHolder holder;
  const int alloc_size = static_cast<int>(packet.payload.size());
  if (!RTMPPacket_Alloc(&holder.pkt, alloc_size)) {
    ILOGS_E << "RTMPPacket_Alloc failed, size=" << packet.payload.size();
    return true;
  }

  std::memcpy(holder.pkt.m_body, packet.payload.data(),
              static_cast<size_t>(alloc_size));
  holder.pkt.m_nBodySize = static_cast<uint32_t>(alloc_size);
  holder.pkt.m_hasAbsTimestamp = 0;
  holder.pkt.m_nTimeStamp = packet.timestamp_ms;

  if (!FillRtmpPacketMeta(packet.packet_type, &holder)) {
    return true;
  }
  // ILOGS_W_FRQ(1000) << "Send packet timestamp: " << holder.pkt.m_nTimeStamp;
  // stream 只提供传输无关的 payload/timestamp/type；
  // 具体 RTMPPacket 组装与发送留在 rtmp 模块内完成。
  if (rtmp_session_->SendPreparedPacket(holder) != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to send packet, timestamp: " << packet.timestamp_ms
            << " packet_type: " << static_cast<int>(packet.packet_type);
  }

  return true;
}

InsErrorCode RtmpPusher::Start() {
  if (push_thread_) {
    return kInsErrorCode_LiveBroadcast_AlreadyStarted;
  }

  if (!rtmp_session_ || !rtmp_session_->IsConnected()) {
    ILOGS_E << "RtmpPusher::Start: rtmp session is not connected";
    return kInsErrorCode_LiveBroadcast_NotConnected;
  }

  if (is_running_.exchange(true)) {
    return kInsErrorCode_LiveBroadcast_AlreadyStarted;
  }

  try {
    stream_reader_ = std::make_unique<StreamReader>();
  } catch (const std::bad_alloc& e) {
    ILOGS_E << "Failed to create stream reader: " << e.what();
    is_running_.store(false);
    return kInsErrorCode_LiveBroadcast_OutOfMemory;
  }

  InsErrorCode result = stream_reader_->Start();
  if (result != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to start stream reader";
    stream_reader_.reset();
    is_running_.store(false);
    return result;
  }

  if (stream_controller_) {
    result = stream_controller_->StartLiveStream();
    if (result != kInsErrorCode_Comm_Success) {
      ILOGS_E << "Failed to start live broadcast stream: " << result;
      stream_reader_->Stop();
      stream_reader_.reset();
      is_running_.store(false);
      return result;
    }
  }

  push_thread_ = std::make_shared<ins::base::Thread>(
      "RtmpPusherThread", std::bind(&RtmpPusher::Run, this));
  if (push_thread_->Start() != kInsErrorCode_Comm_Success) {
    ILOGS_E << "Failed to start push thread";
    if (stream_controller_) {
      stream_controller_->StopLiveStream();
    }
    stream_reader_->Stop();
    stream_reader_.reset();
    push_thread_.reset();
    is_running_.store(false);
    return kInsErrorCode_LiveBroadcast_RtmpPusherStartFailed;
  }
  return kInsErrorCode_Comm_Success;
}

void RtmpPusher::Stop() {
  if (!push_thread_) {
    return;
  }

  InsErrorCode result = kInsErrorCode_Comm_Success;
  if (stream_controller_) {
    result = stream_controller_->StopLiveStream();
    if (result != kInsErrorCode_Comm_Success) {
      ILOGS_E << "Failed to stop live broadcast stream: " << result;
    }
  }

  if (stream_reader_) {
    stream_reader_->Stop();
  }

  is_running_.store(false);
  push_thread_->Join();
  push_thread_.reset();

  if (stream_reader_) {
    stream_reader_.reset();
  }
}
void RtmpPusher::SetStreamController(
    const std::shared_ptr<StreamController>& stream_controller) {
  stream_controller_ = stream_controller;
}

void RtmpPusher::RequestCancelConnect() {
  if (rtmp_session_) {
    rtmp_session_->RequestCancelConnect();
  }
}
