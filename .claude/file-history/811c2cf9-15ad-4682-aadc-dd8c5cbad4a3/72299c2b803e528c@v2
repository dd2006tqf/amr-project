// ========== 静态接口实现 ==========

void LiveStateMachine::SetStreamController(
    const std::shared_ptr<StreamController>& controller) {
  stream_controller_ = controller;
}

void LiveStateMachine::SetNetworkController(
    const std::shared_ptr<NetworkController>& controller) {
  network_controller_ = controller;
}

void LiveStateMachine::SetConfigManager(
    const std::shared_ptr<ConfigManager>& manager) {
  config_manager_ = manager;
}

void LiveStateMachine::SetResumeManager(
    const std::shared_ptr<ResumeManager>& manager) {
  resume_manager_ = manager;
}

void LiveStateMachine::SetManager(
    const std::shared_ptr<LiveBroadcastManager>& manager) {
  manager_ = manager;
}

void LiveStateMachine::SetStateChangeHook(
    const std::function<void(LiveBroadcastState)>& hook) {
  // 线程安全地设置Hook
  // 使用shared_ptr包装，确保读取端可以安全拷贝后调用
  ins::base::AutoMutex lock(hook_mutex_);
  if (hook) {
    state_change_hook_ = std::make_shared<StateChangeCallback>(hook);
  } else {
    state_change_hook_ = nullptr;
  }
}

