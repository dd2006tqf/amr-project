// 静态成员定义
std::shared_ptr<StreamController> LiveStateMachine::stream_controller_ =
    nullptr;
std::shared_ptr<NetworkController> LiveStateMachine::network_controller_ =
    nullptr;
std::shared_ptr<ConfigManager> LiveStateMachine::config_manager_ = nullptr;
std::shared_ptr<ResumeManager> LiveStateMachine::resume_manager_ = nullptr;
std::shared_ptr<LiveBroadcastManager> LiveStateMachine::manager_ = nullptr;

// Hook相关静态成员（线程安全，使用项目标准互斥锁）
std::shared_ptr<LiveStateMachine::StateChangeCallback>
    LiveStateMachine::state_change_hook_ = nullptr;
ins::base::Mutex LiveStateMachine::hook_mutex_;

LiveStateMachine::LiveStateMachine(LiveBroadcastState state) : state_(state) {}

std::string LiveStateMachine::Name() const {
  return std::string(magic_enum::enum_name(state_));
}

void LiveStateMachine::OnStateChange() {
  ILOGS_I << "State changed to: " << Name();

  // 线程安全地获取Hook副本
  // 设计：先加锁拷贝shared_ptr，解锁后再调用，避免持锁调用用户代码
  std::shared_ptr<StateChangeCallback> hook_copy;
  {
    ins::base::AutoMutex lock(hook_mutex_);
    hook_copy = state_change_hook_;
  }

  // 调用Hook（由Manager处理状态变化）
  if (hook_copy && *hook_copy) {
    (*hook_copy)(state_);
  }
}

