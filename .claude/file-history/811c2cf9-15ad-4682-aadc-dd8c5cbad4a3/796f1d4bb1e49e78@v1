### 7. 核心源码走读片段

#### 片段 1：Companion Device 关联与监听注册（Android Kotlin）
```kotlin
class CameraAssociationManager(private val context: Context) {

    private val deviceManager: CompanionDeviceManager =
        context.getSystemService(CompanionDeviceManager::class.java)

    /* 一次性关联：用户在系统弹窗中确认后建立持久关联 */
    fun associateCamera(deviceName: String, mac: String) {
        val request = AssociationRequest.Builder()
            .addDeviceFilter(
                DeviceFilter.Builder()
                    .setName(deviceName)
                    .setAddress(mac)
                    .build()
            )
            .setSingleDevice(true)          /* 只关联这一台，避免多设备歧义 */
            .build()

        deviceManager.associate(request, null, context.mainExecutor) { result ->
            when (result) {
                is AssociationResult.Success -> {
                    /* 关联成功后立刻开始观察设备在场状态 */
                    deviceManager.startObservingDevicePresence(
                        result.deviceInfo.device
                    )
                }
                is AssociationResult.Failure ->
                    Log.e(TAG, "associate failed: ${result.reason}")
            }
        }
    }
}
```
- **`setSingleDevice(true)`**：不加这个，系统可能把名称相近的多台相机都关联上，`onDeviceAppeared` 就无法判断是哪一台，后续 SPP 建链的目标 MAC 会歧义。
- **`startObservingDevicePresence` 是关键一步**：只关联不观察，系统不会在设备出现时回调；关联负责"记住这台设备"，观察负责"设备出现时叫我"，两者职责不同。

#### 片段 2：唤醒服务回调与任务链选取（Android Kotlin）
```kotlin
class CameraWakeupService : CompanionDeviceService() {

    /* 系统检测到关联设备广播时调用，此时 App 主进程可能刚被拉起 */
    override fun onDeviceAppeared(deviceAddress: String?) {
        super.onDeviceAppeared(deviceAddress)
        if (deviceAddress == null) return

        val actionType = resolveActionType(deviceAddress)   /* 判断业务类型 */
        val tasks = taskRegistry.tasksFor(actionType)        /* 查表取任务链 */

        /* 统一交给编排层，门禁与串行逻辑都在那里收口 */
        WakeupOrchestrator.submit(
            WakeupRequest(
                deviceAddress = deviceAddress,
                actionType = actionType,
                tasks = tasks
            )
        )
    }

    override fun onDeviceDisappeared(deviceAddress: String?) {
        super.onDeviceDisappeared(deviceAddress)
        /* 设备消失时取消尚未开始的任务，已在执行的任务交给门禁处理 */
        WakeupOrchestrator.cancelPending(deviceAddress)
    }
}
```
- **`resolveActionType` 的输入是设备地址而非任意参数**：唤醒源是系统回调，参数可信度有限，用设备地址反查业务上下文可以避免被伪造的广播参数带偏。
- **`onDeviceDisappeared` 必须取消未开始任务**：设备已经走了，任务链还在队列里排队，轮到它时会建链失败并占住串行通道，把后续正常唤醒堵死。

#### 片段 3：双重门禁的准入判定（Android Kotlin）
```kotlin
object WakeupOrchestrator {

    private val activeSessions = ConcurrentHashMap<String, SessionHandle>()  /* 设备维度 */
    private val activeChains   = ConcurrentHashMap<String, Job>()            /* 设备加业务维度 */
    private val serialQueue    = Channel<WakeupRequest>(Channel.UNLIMITED)

    fun submit(req: WakeupRequest): Boolean {
        /* 第一重门：同一设备只允许一个会话 */
        activeSessions.putIfAbsent(req.deviceAddress, SessionHandle(req))?.let {
            Log.w(TAG, "session exists for ${req.deviceAddress}, drop")
            return false                                   /* 拒绝重复会话 */
        }

        /* 第二重门：同一设备加同一业务只允许一条任务链 */
        val chainKey = "${req.deviceAddress}:${req.actionType}"
        if (activeChains.containsKey(chainKey)) {
            activeSessions.remove(req.deviceAddress)
            Log.w(TAG, "chain exists for $chainKey, drop")
            return false                                   /* 回滚第一重门 */
        }

        /* 两道门都通过才允许入队，由单通道执行器串行消费 */
        activeChains[chainKey] = Job()
        serialQueue.trySend(req)
        return true
    }
}
```
- **第二重门拒绝时必须回滚第一重门**：这是最容易漏的一行。不回滚的话，`activeSessions` 里会残留一个永远不释放的会话，该设备后续所有唤醒全部被第一重门挡住，功能等同于失效，而且极难从日志里看出原因。
- **两道门在入队前完成**：门禁的作用是把重复请求挡在队列之外，如果只在执行时才检查，队列里已经堆了一串注定要失败的请求，浪费调度且让串行通道空转。

#### 片段 4：iOS 区域监控与设备识别（Objective-C）
```objc
- (void)locationManager:(CLLocationManager*)manager
     didEnterRegion:(CLRegion*)region {
    /* 系统刚把 App 拉起，这里只做唤醒响应，不直接建链 */
    [self markWakeupReason:WakeupReasonBeaconEntry];
    [self startRangingForCamera];     /* 转入扫描，识别具体设备 */
}

- (void)startRangingForCamera {
    CLBeaconRegion* beaconRegion = (CLBeaconRegion*)self.cameraRegion;
    [self.locationManager startRangingBeaconsInRegion:beaconRegion];
}

- (void)locationManager:(CLLocationManager*)manager
     didRangeBeacons:(NSArray<CLBeacon*>*)beacons
            inRegion:(CLBeaconRegion*)region {
    [self.locationManager stopRangingBeaconsInRegion:region];  /* 只需识别一次 */
    if (beacons.count == 0) return;

    CLBeacon* target = [self selectNearestValidBeacon:beacons]; /* 取信号最强 */
    [self.l2capChannel connectToBeacon:target];                 /* 建 L2CAP CoC */
}
```
- **`stopRangingBeaconsInRegion` 必须调用**：`startRanging` 是持续扫描，非常耗电，识别到目标后立刻停止是区域监控的标准收尾动作，否则后台功耗会显著上升。
- **建链放在 `didRangeBeacons` 而不是 `didEnterRegion`**：进入回调不带设备细节，直接建链连不上具体设备；这正是背景知识里说的两步分工。

