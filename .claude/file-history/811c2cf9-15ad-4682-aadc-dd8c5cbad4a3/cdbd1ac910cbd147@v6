InsErrorCode LiveBroadcastManager::RequestStart() {
  // 向状态机专有工作线程投递同步判定指令，等待受理结果
  auto result = work_msg_looper_->PostAndWaitResponse<InsErrorCode>(
      MessageIds::kDispatchStart, 0);
  if (!result.has_value()) {
    ILOGS_E << "PostAndWaitResponse kDispatchStart timeout or failed";
    return InsErrorCode::kErrTimeout;
  }
  return result.value();
