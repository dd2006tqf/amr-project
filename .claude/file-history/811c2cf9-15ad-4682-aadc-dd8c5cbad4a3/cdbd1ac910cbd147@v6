#### 片段 2：命令分发与 IBus 远程客户端调用（`cli/source/commands/live_ctrl_command.cc`）
```cpp
int LiveCtrlCommand::Execute(const std::vector<std::string>& args) {
  if (args.empty()) {
    std::cout << "Usage: live_ctrl <prepare|start|stop|resume|cancel|set_url|set_connect_wifi>\n";
    return -1;
  }

  const std::string& sub_cmd = args[0];
  auto& cli = InsLivecastCli::GetInstance();  // 业务聚合单例

  if (sub_cmd == "prepare") {
    auto err = cli.GetLiveClient()->LiveBroadcastPrepare();
    std::cout << "LiveBroadcastPrepare result: " << ErrorToString(err) << "\n";
  } else if (sub_cmd == "start") {
    auto err = cli.GetLiveClient()->LiveBroadcastStart();
    std::cout << "LiveBroadcastStart result: " << ErrorToString(err) << "\n";
  } else if (sub_cmd == "stop") {
    // 契约强制：stop 必须携带 reason，禁止默认值！
    if (args.size() < 2) {
      std::cout << GetStopUsageHelp();  // 与 help 命令同源的 LiveBroadcastStopReason 说明
      return -1;
    }
    auto reason = ParseStopReason(args[1]);  // 0~6，见背景知识 E 枚举表
    auto err = cli.GetLiveClient()->LiveBroadcastStop(reason);
    std::cout << "LiveBroadcastStop result: " << ErrorToString(err) << "\n";
  }
  return 0;
}
```

