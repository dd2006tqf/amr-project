// Topic 订阅回调统一收敛在 IBus 实现文件中，只做解包 + 跨线程投递
void LiveBroadcastIbusImpl::OnWifiStaOff(const WifiStaPayload& payload) {
  ILOGS_W << "Received WiFi off from netd topic";
  if (auto manager = LiveBroadcastService::GetInstance().GetManager()) {
    // 仅向工作线程投递轻量事件，绝不在通信线程执行耗时逻辑
    manager->PostEvent(LiveEvent::kNetworkDisconnected);
  }
}
```

#### 片段 4：共享内存单写多读原子刷新（`src/manager/live_broadcast_manager.cc`）
```cpp
void LiveBroadcastManager::UpdateShareState(LiveBroadcastState state, uint32_t duration_sec) {
  if (!share_state_ptr_) return;
  
  // release 内存序确保数据完全写毕后状态生效
  share_state_ptr_->duration_sec.store(duration_sec, std::memory_order_relaxed);
  share_state_ptr_->current_state.store(static_cast<uint32_t>(state), std::memory_order_release);
  share_state_ptr_->update_ts_ms.store(GetSteadyTimeMs(), std::memory_order_relaxed);
}
```

