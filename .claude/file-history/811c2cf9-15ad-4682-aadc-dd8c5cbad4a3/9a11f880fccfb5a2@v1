namespace ins::ibus::camera::live_broadcast {

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastPrepare() {
  ILOGS_I << "LiveBroadcastPrepare";
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (!live_broadcast_manager) {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return live_broadcast_manager->LiveBroadcastPrepare();
}

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastStart() {
  ILOGS_I << "LiveBroadcastStart";
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (!live_broadcast_manager) {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return live_broadcast_manager->LiveBroadcastRequestStart();
}

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastStop(
    LiveBroadcastStopReason stop_reason) {
  ILOGS_I << "LiveBroadcastStop, reason=" << static_cast<int32_t>(stop_reason);
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (!live_broadcast_manager) {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return live_broadcast_manager->LiveBroadcastRequestStop(stop_reason);
}

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastGetState(
    LiveBroadcastStateInfo& state_info) {
  ILOGS_I << "LiveBroadcastGetState";
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (live_broadcast_manager) {
    live_broadcast_manager->GetLiveBroadcastState(state_info);
  } else {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return kInsErrorCode_Comm_Success;
}

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastResume() {
  ILOGS_I << "LiveBroadcastResume";
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (!live_broadcast_manager) {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return live_broadcast_manager->LiveBroadcastRequestResume();
}

InsErrorCode LiveBroadcastLiveBroadcastServer::LiveBroadcastDiscardResume() {
  ILOGS_I << "LiveBroadcastDiscardResume";
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (!live_broadcast_manager) {
    ILOGS_E << "LiveBroadcastManager not available";
    return kInsErrorCode_Comm_Enodev;
  }
  return live_broadcast_manager->LiveBroadcastRequestDiscardResume();
}

}  // namespace ins::ibus::camera::live_broadcast

