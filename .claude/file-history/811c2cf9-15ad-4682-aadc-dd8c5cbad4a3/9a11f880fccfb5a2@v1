namespace ins::ibus::camera::config {

void ConfigSubscriber::OnTopicConfigUpdateInfo(
    const std::vector<ConfigKey>& changed_configs) {
  ILOGS_I << "OnTopicConfigUpdateInfo, changed_configs count="
          << changed_configs.size();
  auto live_broadcast_manager =
      ins::live_broadcast::LiveBroadcastService::GetInstance()
          .GetLiveBroadcastManager();
  if (live_broadcast_manager) {
    live_broadcast_manager->OnConfigUpdate(changed_configs);
  }
  static_cast<void>(changed_configs);
}

}  // namespace ins::ibus::camera::config

