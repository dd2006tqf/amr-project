import json, urllib.request

def get(url, timeout=60):
    req = urllib.request.Request(url, headers={'User-Agent': 'curl/8', 'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode('utf-8', 'ignore')

def jget(url):
    try:
        return json.loads(get(url))
    except Exception as e:
        return {'__err__': str(e)}

BR = 'allwinner-aiot-linux-5.15'

print('=== A. sun6i-msgbox.c 是否支持 sun60iw2 ===')
try:
    s = get(f'https://raw.githubusercontent.com/radxa/kernel/{BR}/drivers/mailbox/sun6i-msgbox.c')
    print('bytes:', len(s))
    for kw in ('sun60', 'sun55', 'sun50', 'compatible', 'of_device_id'):
        lines = [l.strip() for l in s.splitlines() if kw in l.lower()]
        print(f'  [{kw}] {len(lines)}', lines[:6])
except Exception as e:
    print('ERR', e)

print('\n=== B. Linux 侧 arisc/rpm 驱动是否存在 ===')
for path in ['drivers/soc/sunxi', 'drivers/misc', 'drivers/rpmsg']:
    d = jget(f'https://api.github.com/repos/radxa/kernel/contents/{path}?ref={BR}')
    if isinstance(d, dict):
        print(path, '->', d.get('message'))
    else:
        names = [x['name'] for x in d]
        print(path, '->', len(names), [n for n in names if any(k in n.lower() for k in ('arisc','rpm','sunxi','sun6'))])

