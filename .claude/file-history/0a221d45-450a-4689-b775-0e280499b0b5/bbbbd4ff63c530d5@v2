import json, re, html, urllib.request

def get(url, timeout=30):
    req = urllib.request.Request(url, headers={'User-Agent': 'curl/8'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()

def text_of(url):
    s = get(url).decode('utf-8', 'ignore')
    s = re.sub(r'(?is)<(script|style).*?</\1>', ' ', s)
    t = re.sub(r'(?s)<[^>]+>', ' ', s)
    t = html.unescape(t)
    t = re.sub(r'[ \t]+', ' ', t)
    t = re.sub(r'\n\s*\n+', '\n', t)
    return t

print('=== radxa kernel build doc: repo & dts hints ===')
try:
    t = text_of('https://docs.radxa.com/cubie/a7a/low-level-dev/build-system/kernel')
    for kw in ['git clone', 'sun60', 'arisc', 'riscv', 'e902', 'dts', 'defconfig', 'github.com']:
        ms = list(re.finditer(kw, t, re.I))
        print(f'--- {kw}: {len(ms)} hits')
        for m in ms[:2]:
            print('   ', t[max(0, m.start()-200):m.start()+260].replace('\n', ' '))
except Exception as e:
    print('ERR', e)

