import json, urllib.request

def get(url, timeout=60):
    req = urllib.request.Request(url, headers={'User-Agent': 'curl/8', 'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode('utf-8', 'ignore')

def jget(url):
    try:
        return json.loads(get(url))
    except Exception as e:
        return {'__err__': str(e)}

print('=== arisc recursive tree (raw) ===')
d = jget('https://api.github.com/repos/radxa/allwinner-arisc/git/trees/main?recursive=1')
print(type(d), list(d)[:5] if isinstance(d, dict) else '')
if isinstance(d, dict):
    t = d.get('tree')
    if t:
        paths = [x['path'] for x in t]
        print('total:', len(paths))
        print('top:', sorted({p.split('/')[0] for p in paths}))
        for k in ('msgbox', 'rpmsg', 'amp', 'ar100', 'sun60', 'a733'):
            sub = [p for p in paths if k in p.lower()]
            print(f'  {k}: {len(sub)}', sub[:10])
    else:
        print(json.dumps(d)[:500])

