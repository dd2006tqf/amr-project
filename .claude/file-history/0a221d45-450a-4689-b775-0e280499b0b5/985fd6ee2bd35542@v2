print('\n=== C) 是否有 sunxi 专属 remoteproc / arisc 驱动 ===')
for path in ['drivers/remoteproc', 'drivers/soc/sunxi', 'drivers/misc/sunxi']:
    d = jget(f'https://api.github.com/repos/radxa/kernel/contents/{path}?ref={BR}')
    if isinstance(d, dict):
        print(path, '->', d.get('message'))
    else:
        names = [x['name'] for x in d]
        print(path, '->', len(names))
        print('   sunxi-ish:', [n for n in names if any(k in n.lower() for k in ('sun','allwin','arisc','rproc','riscv','e902'))] or '(none)')

