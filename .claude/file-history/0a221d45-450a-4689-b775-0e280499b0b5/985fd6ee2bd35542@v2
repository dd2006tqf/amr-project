import json, urllib.request

def get(url, timeout=90):
    req = urllib.request.Request(url, headers={'User-Agent': 'curl/8', 'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode('utf-8', 'ignore')

def jget(url):
    try:
        return json.loads(get(url))
    except Exception as e:
        return {'__err__': str(e)}

BR = 'allwinner-aiot-linux-5.15'

print('=== A) hwspinlock Kconfig 是否有 SUNXI ===')
try:
    s = get(f'https://raw.githubusercontent.com/radxa/kernel/{BR}/drivers/hwspinlock/Kconfig')
    lines = [l for l in s.splitlines() if 'SUN' in l.upper() or 'sunxi' in l.lower()]
    print('sunxi Kconfig lines:', lines if lines else '(NONE)')
except Exception as e:
    print('ERR', e)

print('\n=== B) sun6i_hwspinlock.c 支持的 compatible ===')
try:
    s = get(f'https://raw.githubusercontent.com/radxa/kernel/{BR}/drivers/hwspinlock/sun6i_hwspinlock.c')
    idx = s.find('of_device_id')
    print(s[idx-100: idx+400] if idx > 0 else s[:500])
except Exception as e:
