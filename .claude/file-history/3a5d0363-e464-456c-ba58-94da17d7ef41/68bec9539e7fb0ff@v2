/// 计时结果。median / p95 都要，因为平均会被个别调度抖动带偏。
struct Stats
{
  double median_ns{0.0};
  double p95_ns{0.0};
  double mean_ns{0.0};
};

Stats Summarize(std::vector<double> samples)
{
  if (samples.empty()) return {};
  std::sort(samples.begin(), samples.end());
  const std::size_t n = samples.size();
  const std::size_t mid = n / 2;
  Stats s;
  s.median_ns = (n % 2 == 1) ? samples[mid]
                             : 0.5 * (samples[mid - 1] + samples[mid]);
  s.p95_ns = samples[std::min(n - 1, static_cast<std::size_t>(n * 0.95))];
  double sum = 0.0;
  for (double v : samples) sum += v;
  s.mean_ns = sum / static_cast<double>(n);
  return s;
}

/// 测一个可调用对象单次执行的耗时分布。
///
/// 先跑 warmup：首次调用会触发热路径（protobuf 的 arena 初始化、字符串池等），
/// 把那些算进去会得到「首次投影 30 微秒」这种对稳态毫无意义的结果。
template<typename Fn>
Stats TimeIt(Fn && fn, int iterations, int warmup = 2000)
{
  for (int i = 0; i < warmup; ++i) fn();
  std::vector<double> samples;
  samples.reserve(static_cast<std::size_t>(iterations));
  for (int i = 0; i < iterations; ++i) {
    const auto t0 = Clock::now();
    fn();
    const auto t1 = Clock::now();
    samples.push_back(
      std::chrono::duration<double, std::nano>(t1 - t0).count());
  }
  return Summarize(std::move(samples));
}

/// 单条消息的完整基准：投影 + 序列化。
template<typename RosidlT, typename ProtoT>
void BenchOne(
  const char * label, int iterations, RosidlT rosidl_msg)
{
  ProtoT proto_msg;

  // 1) 投影（rosidl -> proto）：这是双发**新增**的纯 CPU 成本。
  const Stats proj = TimeIt(
    [&]() { amr_dispatcher_ros::ProjectRosidlToProto(rosidl_msg, &proto_msg); },
    iterations);

  // 2) 序列化：DDS 在 publish() 里做的事，双发让它跑两遍。
  //    这里测 protobuf 的那一遍（rosidl 侧由 Fast DDS 做，本进程测不到）。
  const Stats ser = TimeIt(
    [&]() {
      std::string buf;
      proto_msg.SerializeToString(&buf);
    },
    iterations);

  // 3) 先投影一次再测序列化：真实路径上序列化的就是投影后的内容。
  amr_dispatcher_ros::ProjectRosidlToProto(rosidl_msg, &proto_msg);
  std::string payload;
  proto_msg.SerializeToString(&payload);

  std::printf(
    "%-22s  投影 %7.0f ns (p95 %7.0f)  序列化 %7.0f ns (p95 %7.0f)  "
    "proto %4zu B\n",
    label,
    proj.median_ns, proj.p95_ns,
    ser.median_ns, ser.p95_ns,
    payload.size());
}

}  // namespace

int main(int argc, char ** argv)
{
  int iterations = 100000;
  for (int i = 1; i < argc; ++i) {
    const std::string arg = argv[i];
    if (arg == "--iterations" && i + 1 < argc) {
      iterations = std::atoi(argv[++i]);
      if (iterations <= 0) {
        std::fprintf(stderr, "--iterations 必须是正整数\n");
        return 2;
      }
    } else if (arg == "--help" || arg == "-h") {
      std::printf(
        "用法: proto_dual_benchmark [--iterations N]\n"
        "\n"
        "测量双发相对单发的 CPU 增量（投影 + 序列化），不参与 pass/fail。\n"
        "同样的代码在冷/热缓存下能差数倍，请在同一台机器上做前后对比。\n");
      return 0;
    }
  }

  std::printf("双发开销基准（iterations=%d，中位数/p95，单位 ns）\n", iterations);
  std::printf("%s\n", std::string(78, '-').c_str());

  BenchOne<amr_dispatcher_interfaces::msg::ChassisLinkHealth,
    amr_dispatcher::proto::ChassisLinkHealth>(
    "ChassisLinkHealth", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::ChassisLinkHealth>());

  BenchOne<amr_dispatcher_interfaces::msg::TrackingError,
    amr_dispatcher::proto::TrackingError>(
    "TrackingError", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::TrackingError>());

  BenchOne<amr_dispatcher_interfaces::msg::SafetyState,
    amr_dispatcher::proto::SafetyState>(
    "SafetyState", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::SafetyState>());

  BenchOne<amr_dispatcher_interfaces::msg::TopologyState,
    amr_dispatcher::proto::TopologyState>(
    "TopologyState", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::TopologyState>());

  BenchOne<amr_dispatcher_interfaces::msg::MissionEvent,
    amr_dispatcher::proto::MissionEvent>(
    "MissionEvent", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::MissionEvent>());

  BenchOne<amr_dispatcher_interfaces::msg::DispatcherState,
    amr_dispatcher::proto::DispatcherState>(
    "DispatcherState", iterations, MakeTypical<
      amr_dispatcher_interfaces::msg::DispatcherState>());

  std::printf("%s\n", std::string(78, '-').c_str());
  std::printf(
    "解读：投影是一次性 CPU 成本，序列化是双发翻倍的那部分。\n"
    "      以 TrackingError(20Hz) 为例，若投影 200ns、序列化 300ns，\n"
    "      则每秒新增 20 × 500ns = 10 微秒，占总 CPU 的比例可忽略。\n");
  return 0;
}
