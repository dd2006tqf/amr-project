#!/usr/bin/env bash
set +u
source /opt/ros/jazzy/setup.bash
source /workspace/install/setup.bash
set -u

PKG=$(ros2 pkg prefix amr_dispatcher_ros)
DISP="$PKG/lib/amr_dispatcher_ros/dispatcher_node"

"$DISP" --ros-args -r __node:=disp_cutover_probe -p proto_rosidl_publish:=false > /tmp/disp_cutover.log 2>&1 &
PID=$!
sleep 4
ros2 lifecycle set /disp_cutover_probe configure > /dev/null 2>&1
sleep 2
ros2 lifecycle set /disp_cutover_probe activate > /dev/null 2>&1
sleep 3

echo "=== 每话题的 writer 数（按节点名过滤 disp_cutover_probe）==="
for t in /dispatcher/state /dispatcher/state_proto \
         /dispatcher/events /dispatcher/events_proto \
         /dispatcher/topology_state /dispatcher/topology_state_proto; do
  info=$(ros2 topic info "$t" -v 2>/dev/null || true)
  probe=$(printf '%s\n' "$info" | grep -c 'disp_cutover_probe' || true)
  total=$(printf '%s\n' "$info" | sed -n 's/^Publisher count: //p' | head -1)
  echo "$t : probe_writer=$probe total_publishers=${total:-?}"
done

echo
echo "=== /plan 应仍有 probe 的 writer（nav_msgs::Path 不受开关影响）==="
ros2 topic info /plan -v 2>/dev/null | grep -c 'disp_cutover_probe' || true

kill $PID 2>/dev/null || true
wait 2>/dev/null || true
