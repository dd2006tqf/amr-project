{
  "env": {
    "ANTHROPIC_BASE_URL": "https://laneai.dev",
    "ANTHROPIC_REASONING_MODEL": "deepseek-v4.1-flash",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "modelOverrides": {
    "claude-opus-5-5": "deepseek-v4.1-flash",
    "claude-opus-4-7": "deepseek-v4.1-flash",
    "claude-sonnet-5-5": "deepseek-v4.1-flash",
    "claude-sonnet-4-6": "deepseek-v4.1-flash",
    "claude-haiku-4-5": "deepseek-v4.1-flash",
    "deepseek-v4-pro-0813": "deepseek-v4.1-flash",
    "deepseek-v4-pro-0813[1m]": "deepseek-v4.1-flash",
    "deepseek-v4-pro": "deepseek-v4.1-flash",
    "deepseek-v4-flash": "deepseek-v4.1-flash",
    "deepseek-v4.1-flash": "deepseek-v4.1-flash"
  },
  "disableClaudeAiConnectors": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "setsid bash -c 'echo -ne \"\\a\"' >/dev/null 2>&1",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "respondToBashCommands": false,
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "fast-web-search": {
      "command": "/home/ubuntu/.npm-global/bin/fast-web-search-mcp",
      "env": {
        "FWSMCP_LOG_LEVEL": "warn",
        "FWSMCP_DEFAULT_REGION": "us-en",
        "FWSMCP_DEFAULT_LANGUAGE": "en",
        "FWSMCP_PROVIDERS": "bing"
      }
    }
  }
}
