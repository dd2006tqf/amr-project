#!/usr/bin/env python3
"""统计 Claude Code 会话 token 用量，按本地日期（+0800）汇总。"""
import json
import os
from collections import defaultdict
from datetime import datetime, timedelta, timezone

ROOT = os.path.expanduser("~/.claude/projects")
TZ = timezone(timedelta(hours=8))

stats = defaultdict(lambda: {"n": 0, "inp": 0, "cc": 0, "cr": 0, "out": 0})
per_file = defaultdict(lambda: {"n": 0, "total": 0})
bad = 0

for dirpath, _dirnames, filenames in os.walk(ROOT):
    for fn in filenames:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(dirpath, fn)
        rel = os.path.relpath(path, ROOT)
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    bad += 1
                    continue
                if rec.get("type") != "assistant":
                    continue
                msg = rec.get("message") or {}
                usage = msg.get("usage")
                if not isinstance(usage, dict):
                    continue
                ts = rec.get("timestamp")
                if not ts:
                    continue
                try:
                    dt = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone(TZ)
                except ValueError:
                    continue
                day = dt.strftime("%Y-%m-%d")
                inp = usage.get("input_tokens") or 0
                cc = usage.get("cache_creation_input_tokens") or 0
                cr = usage.get("cache_read_input_tokens") or 0
                out = usage.get("output_tokens") or 0
                s = stats[day]
                s["n"] += 1
                s["inp"] += inp
                s["cc"] += cc
                s["cr"] += cr
                s["out"] += out
                pf = per_file[rel]
                pf["n"] += 1
                pf["total"] += inp + cc + cr + out

print("=== 按日期汇总（本地时间 UTC+8）===")
hdr = f"{'日期':<12}{'请求数':>8}{'输入(新)':>13}{'缓存写入':>13}{'缓存命中':>13}{'输出':>11}{'合计':>14}"
print(hdr)
print("-" * len(hdr))

tot = {"n": 0, "inp": 0, "cc": 0, "cr": 0, "out": 0}
for day in sorted(stats):
    s = stats[day]
    total = s["inp"] + s["cc"] + s["cr"] + s["out"]
    print(
        f"{day:<12}{s['n']:>8}{s['inp']:>13,}{s['cc']:>13,}"
        f"{s['cr']:>13,}{s['out']:>11,}{total:>14,}"
    )
    for k in tot:
        tot[k] += s[k]

gtotal = tot["inp"] + tot["cc"] + tot["cr"] + tot["out"]
print("-" * len(hdr))
print(
    f"{'总计':<12}{tot['n']:>8}{tot['inp']:>13,}{tot['cc']:>13,}"
    f"{tot['cr']:>13,}{tot['out']:>11,}{gtotal:>14,}"
)

if bad:
    print(f"\n(跳过 {bad} 行无法解析的 JSON)")
