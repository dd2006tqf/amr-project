p='scripts/setup_libcurl_sysroot.sh'
s=open(p,encoding='utf-8').read()

old_perl = (
    "    sub fetch {\n"
    "      my ($h, $p) = @_;\n"
    "      my $s = IO::Socket::INET->new(PeerHost => $h, PeerPort => 80, Timeout => 60)\n"
    "        or die \"connect $h: $!\\n\";\n"
)
new_perl = (
    "    # 全局兜底：90s 内没跑完就 die，让调用方换下一个源。\n"
    "    $SIG{ALRM} = sub { die \"timeout after 90s: $url\\n\" };\n"
    "    alarm 90;\n"
    "\n"
    "    sub fetch {\n"
    "      my ($h, $p) = @_;\n"
    "      my $s = IO::Socket::INET->new(PeerHost => $h, PeerPort => 80, Timeout => 15)\n"
    "        or die \"connect $h: $!\\n\";\n"
    "      $s->autoflush(1);\n"
)
assert s.count(old_perl) == 1, ("perl", s.count(old_perl))
s = s.replace(old_perl, new_perl)

old_close = (
    "    close($fh);\n"
    "  ' \"$1\" \"$2\"\n"
)
new_close = (
    "    close($fh);\n"
    "    alarm 0;\n"
    "  ' \"$1\" \"$2\"\n"
)
assert s.count(old_close) == 1, ("close", s.count(old_close))
s = s.replace(old_close, new_close)

old_dl = (
    "download() {  # $1=url  $2=outfile\n"
    "  if command -v curl >/dev/null 2>&1; then\n"
    "    curl -fsSL --max-time 300 -o \"$2\" \"$1\"\n"
    "  elif command -v wget >/dev/null 2>&1; then\n"
    "    wget -q -O \"$2\" \"$1\"\n"
)
new_dl = (
    "download() {  # $1=url  $2=outfile\n"
    "  if command -v curl >/dev/null 2>&1; then\n"
    "    # --connect-timeout 15 + --max-time 60：源不可达时快速失败换下一个源，\n"
    "    # 不把整个 sysroot 步骤挂死在一个连不上的站点上。\n"
    "    curl -fsSL --connect-timeout 15 --max-time 60 -o \"$2\" \"$1\"\n"
    "  elif command -v wget >/dev/null 2>&1; then\n"
    "    wget -q --connect-timeout=15 --timeout=60 -O \"$2\" \"$1\"\n"
)
assert s.count(old_dl) == 1, ("dl", s.count(old_dl))
s = s.replace(old_dl, new_dl)

open(p,'w',encoding='utf-8').write(s)
print("patched libcurl")
