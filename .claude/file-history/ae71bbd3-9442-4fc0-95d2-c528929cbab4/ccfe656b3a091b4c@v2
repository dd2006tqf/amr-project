#pragma once

#include <cstdint>
#include <functional>
#include <array>
#include <mutex>
#include "sync/frame_timestamp.h"

namespace xgrids {

// 每通道的实时统计
struct ChannelStats {
    uint64_t frame_count = 0;
    int64_t last_ts_us = -1;
    int64_t last_seq = -1;
    double ema_interval_us = 0;   // 帧间隔指数滑动平均
    uint32_t dropped_seq = 0;     // 按帧号连续性检出的丢帧数
    uint32_t jitter_violations = 0;
};

// 帧同步监控器：对应简历"实时统计帧间隔抖动与帧号连续性，
// 任一路同步误差超阈值即触发状态上报"。
class SyncMonitor {
public:
    struct Config {
        int64_t max_skew_us = 2000;      // 组内最大允许偏移
        int64_t jitter_thresh_us = 8000; // 单路帧间隔偏离均值阈值
        int64_t expected_fps_x1000 = 20000; // 预期帧率（fps*1000 定点）
    };

    using AlertCallback = std::function<void(int channel, const char* reason)>;

    SyncMonitor(Config cfg, AlertCallback on_alert);

    // 喂入一路一帧；每帧调用（采集线程，必须不阻塞）
    void on_frame(const FrameMeta& f);

    // 周期性输出汇总（供 UI / manifest / 后端）
    std::array<ChannelStats, 4> stats() const;
    uint64_t sync_group_count() const { return group_count_; }
    uint64_t violation_count() const { return violation_count_; }

private:
    Config cfg_;
    AlertCallback on_alert_;
    mutable std::mutex mu_;
    std::array<ChannelStats, 4> ch_{};
    FrameGrouper grouper_;
    uint64_t group_count_ = 0;
    uint64_t violation_count_ = 0;
};

}  // namespace xgrids
