#pragma once

#include <cstdint>
#include <string>
#include <queue>
#include <mutex>
#include <functional>
#include <thread>
#include <atomic>
#include <condition_variable>
#include "backend/storage_backend.h"

namespace xgrids {

// ============================================================
// 上传器（断点续传 + manifest 优先 + 指数退避）
//
// 真实场景约束：
//   1) manifest.json 必须先传——后端先判完整性，决定是否等完整数据
//   2) 设备断电要能断点续传——记录已确认的字节偏移
//   3) 弱网环境：带宽下降时降码率而非阻塞；重试用指数退避
// ============================================================

struct UploadTask {
    std::string scan_id;
    std::string scan_dir;
    StorageBackend::PacketInfo info;
    // 上传状态
    enum State { kPending, kManifestSent, kUploading, kDone, kFailed } state = kPending;
    uint64_t manifest_sent_bytes = 0;   // manifest 单独先传
    uint64_t data_sent_bytes = 0;       // 帧数据断点
    int retry = 0;
    int64_t last_retry_us = 0;
};

class Uploader {
public:
    struct Config {
        std::string endpoint;
        double max_bw_mbps = 50.0;
        int max_retry = 5;
        // 指数退避：base * 2^retry，封顶 60s
        int64_t retry_base_us = 1'000'000;
        int64_t retry_max_us = 60'000'000;
    };

    using ProgressCb = std::function<void(const UploadTask&, double pct)>;

    Uploader(Config cfg, ProgressCb cb);
    ~Uploader() { stop(); }

    void start();
    void stop();

    void enqueue(const UploadTask& t);

    // 断点恢复：断电重启后，从未完成的分片继续
    // （简化：记录 sent_bytes 到 task.state，下次接着传）
    bool resume_task(UploadTask& t);

    void inject_disconnect(int ms);
    void set_bandwidth_mbps(double mbps) { cfg_.max_bw_mbps = mbps; }

    size_t pending() const;
    uint64_t uploaded_bytes() const { return uploaded_bytes_.load(); }

private:
    void loop();
    bool upload_manifest(UploadTask& t);
    bool upload_data(UploadTask& t);
    bool send_chunk(const std::string& path, int64_t offset, int64_t len);
    bool is_disconnected() const;
    void sleep_retry(int retry);

    Config cfg_;
    ProgressCb cb_;
    std::queue<UploadTask> q_;
    mutable std::mutex mu_;
    std::condition_variable cv_;
    std::thread worker_;
    std::atomic<bool> running_{false};
    std::atomic<int64_t> disconnect_until_us_{0};
    std::atomic<uint64_t> uploaded_bytes_{0};
};

}  // namespace xgrids
