#include "sensors/sensor_drivers.h"
#include <thread>
#include <chrono>

namespace xgrids {

// ---------------- CameraSim ----------------
void CameraSim::start(std::atomic<bool>& running) {
    rng_.seed(std::random_device{}() + p_.channel_id);
    std::uniform_real_distribution<double> u01(0.0, 1.0);
    std::uniform_int_distribution<uint8_t> blur(200, 255);
    std::uniform_real_distribution<double> lux_j(220.0, 420.0);

    const int64_t base_interval_us = 1'000'000 / p_.fps;
    uint32_t seq = 0;

    while (running.load()) {
        double scale = fps_scale_.load();
        int64_t interval = (int64_t)(base_interval_us * scale);
        int64_t jit_amp = jitter_us_.load() > 0 ? jitter_us_.load() : p_.exposure_jitter_us;
        std::uniform_int_distribution<int64_t> jit(-jit_amp, jit_amp);
        int64_t ts = MonotonicClock::now_us() + jit(rng_);

        int burst = drop_burst_.load();
        if (burst > 0) { drop_burst_.fetch_sub(1); }
        else if (u01(rng_) < p_.drop_prob) { burst = 1; }

        if (burst > 0) {
            seq++;  // 帧号跳变，上层据此检出丢帧
            std::this_thread::sleep_for(std::chrono::microseconds(interval));
            continue;
        }

        ImageFrame f;
        f.meta = {p_.channel_id, ts, seq++, p_.width * p_.height * 3 / 2,
                  (uint16_t)p_.width, (uint16_t)p_.height};
        f.yuv.assign(f.meta.bytes, uint8_t(p_.channel_id * 40 + (seq & 0xFF)));
        f.lux = lux_j(rng_);
        f.blur_score = blur(rng_);
        out_(f);

        std::this_thread::sleep_for(std::chrono::microseconds(interval));
    }
}

// ---------------- LidarSim ----------------
void LidarSim::start(std::atomic<bool>& running) {
    std::mt19937 rng{std::random_device{}()};
    const int64_t period_us = 100'000;  // 10Hz
    uint32_t seq = 0;
    while (running.load()) {
        LidarFrame f;
        f.ts_us = MonotonicClock::now_us();
        f.seq = seq++;
        f.point_count = points_;
        f.xyz.resize(points_ * 3);
        // 填环形扫描点云（占位，应用层只关心帧到了）
        for (int i = 0; i < points_; ++i) {
            f.xyz[i*3]   = std::cos(i * 0.01f) * 10.0f;
            f.xyz[i*3+1] = std::sin(i * 0.01f) * 10.0f;
            f.xyz[i*3+2] = (i % 100) * 0.05f;
        }
        f.intensity.assign(points_, 128);
        out_(f);
        std::this_thread::sleep_for(std::chrono::microseconds(period_us));
    }
}

// ---------------- ImuSim ----------------
void ImuSim::start(std::atomic<bool>& running) {
    const int64_t period_us = 5'000;  // 200Hz
    std::mt19937 rng{std::random_device{}()};
    std::normal_distribution<float> nz(0.f, 0.01f);
    while (running.load()) {
        ImuPacket p;
        p.ts_us = MonotonicClock::now_us();
        p.ax = nz(rng); p.ay = nz(rng); p.az = 9.8f + nz(rng);
        p.gx = nz(rng); p.gy = nz(rng); p.gz = nz(rng);
        out_(p);
        std::this_thread::sleep_for(std::chrono::microseconds(period_us));
    }
}

// ---------------- GnssSim ----------------
void GnssSim::start(std::atomic<bool>& running) {
    const int64_t period_us = 1'000'000;  // 1Hz
    double lat = 22.5431, lon = 113.9344;
    while (running.load()) {
        GnssFix f;
        f.ts_us = MonotonicClock::now_us();
        if (loss_lock_.load()) {
            f.fix_type = 1;       // 失锁 -> 单点解
            f.hdop = 5.0f;
        } else {
            f.fix_type = 4;       // RTK 固定解
            f.hdop = 0.6f;
        }
        f.lat = lat; f.lon = lon; f.alt = 15.0;
        f.num_sats = 28;
        out_(f);
        // 模拟缓慢移动
        lat += 1e-6; lon += 1e-6;
        std::this_thread::sleep_for(std::chrono::microseconds(period_us));
    }
}

}  // namespace xgrids
