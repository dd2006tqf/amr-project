void CliTerminal::SetupReplxx() {
  // 1. 设置 Tab 键自动补全回调
  replxx_instance_.set_completion_callback(
      [this](const std::string& input, int& context_len) {
        return command_manager_->GetCompletions(input, context_len);
      });

  // 2. 设置语法高亮着色规则
  replxx_instance_.set_highlighter_callback(
      [](const std::string& input, replxx::Replxx::colors_t& colors) {
        // 命令主体渲染为主色（绿色），参数渲染为黄色
        for (size_t i = 0; i < input.size(); ++i) {
          if (input[i] == ' ') break;
          colors[i] = replxx::Replxx::Color::GREEN;
        }
      });
      
  replxx_instance_.install_window_change_handler();
}
