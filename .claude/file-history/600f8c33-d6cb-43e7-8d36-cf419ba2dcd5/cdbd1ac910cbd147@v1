#### 片段 2：代次标识原子递增与绑定（`src/manager/live_broadcast_manager.cc`）
```cpp
uint64_t LiveBroadcastManager::BeginStartAttempt() {
  // 原子递增序列号并发布为当前活跃代次
  const uint64_t attempt_id =
      start_attempt_seq_.fetch_add(1, std::memory_order_relaxed) + 1;
  active_start_attempt_.store(attempt_id, std::memory_order_release);
  ILOGS_I << "Begin new start attempt: id=" << attempt_id;
  return attempt_id;
}
```

#### 片段 3：连接线程带代次启动与过期结果防御性丢弃（`src/state_machine/live_state_starting.cc` & `manager.cc`）
```cpp
// 1. Starting 状态中启动连接线程
void LiveStateStarting::OnEntry() {
  const uint64_t attempt_id = manager_->BeginStartAttempt();
  auto pusher = manager_->GetRtmpPusher();
  auto weak_mgr = manager_->GetWeakPtr();

  manager_->StartConnectThread([weak_mgr, pusher, attempt_id]() {
    // 在独立连接线程中执行耗时网络握手
    auto err = pusher->Connect();
    if (auto mgr = weak_mgr.lock()) {
      // 投递结果回工作线程，携带本线程专属的 attempt_id
      mgr->PostStartResult(attempt_id, err, "");
    }
  });
}

// 2. 工作线程中检验代次
void LiveBroadcastManager::OnStartResult(const StartResultPayload& payload) {
  const uint64_t active_attempt = active_start_attempt_.load(std::memory_order_acquire);
  if (payload.attempt_id != active_attempt) {
    // 关键守卫：代次不匹配，说明是已被取消的旧连接操作，果断忽略！
    ILOGS_W << "Ignore stale start result: payload_attempt=" << payload.attempt_id
            << ", active_attempt=" << active_attempt;
    return;
  }
  // 代次完全匹配，驱动状态机进入 Running 或 Prepare
  if (payload.err == InsErrorCode::kSuccess) {
    state_machine_->Dispatch(EventStartSuccess{});
  } else {
    state_machine_->Dispatch(EventStartFailed{payload.err});
  }
}
```

#### 片段 4：15s 超时 Join + Detach 降级守护（`src/manager/live_broadcast_manager.cc`）
```cpp
void LiveBroadcastManager::StopConnectThreadSafe() {
  if (!connect_thread_ || !connect_thread_->joinable()) return;

  // 1. 尝试等待线程退出，设置超时时间为 15 秒
  std::future<void> future = std::async(std::launch::async, [this]() {
    if (connect_thread_->joinable()) connect_thread_->join();
  });

  if (future.wait_for(std::chrono::seconds(15)) == std::future_status::timeout) {
    ILOGS_E << "Connect thread join timeout (15s)! Detaching to avoid hang...";
    // 2. 触发降级：剥离线程所有权，防止析构阻塞进程关停
    connect_thread_->detach();
    // 3. 强制关闭底层套接字，解除系统调用阻塞
    if (rtmp_pusher_) rtmp_pusher_->ForceCloseSocket();
  } else {
    ILOGS_I << "Connect thread joined successfully";
  }
  connect_thread_.reset();
}
```

