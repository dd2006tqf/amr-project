#### 片段 2：命令分发与 IBus 远程客户端调用（`cli/source/commands/live_ctrl_command.cc`）
```cpp
int LiveCtrlCommand::Execute(const std::vector<std::string>& args) {
  if (args.empty()) {
    std::cout << "Usage: live_ctrl <prepare|start|stop|set_url> [params]\n";
    return -1;
  }

  const std::string& sub_cmd = args[0];
  auto client = GetIbusClient(); // 获取 IBus RPC Client 代理

  if (sub_cmd == "prepare") {
    auto err = client->LiveBroadcastPrepare();
    std::cout << "LiveBroadcastPrepare result: " << ErrorToString(err) << "\n";
  } else if (sub_cmd == "start") {
    auto err = client->LiveBroadcastStart();
    std::cout << "LiveBroadcastStart result: " << ErrorToString(err) << "\n";
  } else if (sub_cmd == "stop") {
    auto reason = LiveBroadcastStopReason::kUserManual;
    auto err = client->LiveBroadcastStop(reason);
    std::cout << "LiveBroadcastStop result: " << ErrorToString(err) << "\n";
  }
  return 0;
}
```

