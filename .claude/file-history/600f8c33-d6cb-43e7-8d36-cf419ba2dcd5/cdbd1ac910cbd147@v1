InsErrorCode LiveStateBase::HandleStart(const EventStart& evt) {
  // 基类默认拦截非法状态下的开播请求
  ILOGS_W << "Reject Start event in state: " << GetStateName()
          << ", active_state=" << static_cast<int>(GetStateEnum());
